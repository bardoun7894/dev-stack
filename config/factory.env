# Factory flow configuration (spec-002-factory-flow)
# Maximum open PRs waiting on auto-merge per project before jdelegate refuses new build workers (R1, Q2=3)
FACTORY_WIP_LIMIT="${FACTORY_WIP_LIMIT:-3}" # 3

# Project -> GitHub owner/repo mapping (space or newline separated project=owner/repo pairs)
FACTORY_REPOS="${FACTORY_REPOS:-
mediatgb=bardoun7894/mediatgb
crmai=bardoun7894/crmAi
transport-tms=bardoun7894/transport-tms
lab_chemical=bardoun7894/lab_chemical
dev-stack=bardoun7894/dev-stack
tokyo=bardoun7894/tokyo
}"

# Repos that have PR-triggered CI with required check 'ci-ok' and GitHub auto-merge enabled (R2, R9)
FACTORY_AUTOMERGE_REPOS="${FACTORY_AUTOMERGE_REPOS-
bardoun7894/mediatgb
}"

# Allowlisted GitHub logins whose <!-- haiku-review sha=... --> comment/review verdicts are trusted by prqueue_arm_automerge
FACTORY_REVIEW_AUTHORS="${FACTORY_REVIEW_AUTHORS-pr-review[bot] github-actions[bot]}"
