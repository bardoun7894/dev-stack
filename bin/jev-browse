#!/usr/bin/env bash
# jev-browse — System 1 browser agent (see skills/jev/scripts/jev-browse.mjs and skills/jev/references/e2e-browsing.md)
src="$0"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd "$(dirname "$src")" && pwd)"
exec node "$here/../skills/jev/scripts/jev-browse.mjs" "$@"
