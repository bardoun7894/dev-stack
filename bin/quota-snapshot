#!/usr/bin/env python3
"""quota-snapshot — remaining-quota snapshot of the owner's subscription providers for jdelegate's ranking.

Writes ~/.cache/jev-router/quota.json atomically:
  {"at": iso, "providers": {"<id>": {"five_hour": f|null, "weekly": f|null, "monthly": f|null,
                                      "resets": {...}, "source": "api|local|estimate|error", "at": iso, "note": str}}}
f is the used fraction 0..1. Each source is fail-soft (error -> source "error", windows null). Tokens are never printed or stored.
  cliproxy       Anthropic oauth usage endpoint (read-only use of the Claude Code token)
  openai-codex   newest token_count rate_limits in ~/.codex/sessions
  openrouter     GET /api/v1/credits (key from opencode auth or OPENROUTER_API_KEY); also writes the daily spend file
  xai            no read-only balance endpoint; source "none" (the launch watchdog's exhausted.json 402 entries are the signal)
  opencode-go, commandcode   no API: our own jdelegate runs in ~/.cache/jdelegate over tiers.json quota_caps
Options: --print (compact table), --no-write. Env: QUOTA_SNAPSHOT_OUT, JEV_ROUTER_CONFIG, JDELEGATE_CACHE, CODEX_SESSIONS_DIR, CLAUDE_CREDENTIALS,
QUOTA_CLAUDE_AUTH_DIR (cliproxy auth dir, default /root/.cli-proxy-api), QUOTA_SPEND_OUT, OPENROUTER_API_KEY, OPENCODE_AUTH.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.request
from concurrent.futures import ThreadPoolExecutor, wait
from datetime import datetime, timedelta, timezone

HOME = os.path.expanduser("~")
OUT = os.environ.get("QUOTA_SNAPSHOT_OUT", os.path.join(HOME, ".cache", "jev-router", "quota.json"))
CONFIG = os.environ.get("JEV_ROUTER_CONFIG", os.path.join(HOME, ".config", "jev-router", "tiers.json"))
RUNS = os.environ.get("JDELEGATE_CACHE", os.path.join(HOME, ".cache", "jdelegate"))
CODEX = os.environ.get("CODEX_SESSIONS_DIR", os.path.join(HOME, ".codex", "sessions"))
CREDS = os.environ.get("CLAUDE_CREDENTIALS", os.path.join(HOME, ".claude", ".credentials.json"))
AUTH_DIR = os.environ.get("QUOTA_CLAUDE_AUTH_DIR", "/root/.cli-proxy-api")
SPEND_OUT = os.environ.get("QUOTA_SPEND_OUT", os.path.join(HOME, ".cache", "jev-router", "openrouter-spend.json"))
OPENCODE_AUTH = os.environ.get("OPENCODE_AUTH", os.path.join(HOME, ".local", "share", "opencode", "auth.json"))
CREDITS_URL = "https://openrouter.ai/api/v1/credits"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
TOTAL_TIMEOUT = 8
ESTIMATED = ("opencode-go", "commandcode")
WINDOWS = {"five_hour": timedelta(hours=5), "weekly": timedelta(days=7), "monthly": timedelta(days=30)}


def iso(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def blank(source, note="", **kw):
    return {"five_hour": None, "weekly": None, "monthly": None, "resets": {}, "source": source, "note": note, **kw}


def frac(pct):
    return max(0.0, min(1.0, float(pct) / 100.0))


# ── cliproxy / Claude ───────────────────────────────────────────────────
def parse_claude(body):
    if not isinstance(body, dict):
        return blank("error", "unexpected usage payload")
    r = blank("api")
    for key, field in (("five_hour", "five_hour"), ("weekly", "seven_day")):
        w = body.get(field)
        if isinstance(w, dict) and isinstance(w.get("utilization"), (int, float)):
            r[key] = frac(w["utilization"])
            if w.get("resets_at"):
                r["resets"][key] = w["resets_at"]
    if r["five_hour"] is None and r["weekly"] is None:
        return blank("error", "no utilization in usage payload")
    r["note"] = "monthly window not exposed"
    return r


def claude_token(creds_path, use_keychain):
    blobs = []
    if use_keychain and sys.platform == "darwin":
        try:
            p = subprocess.run(["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                               capture_output=True, text=True, timeout=3)
            if p.returncode == 0:
                blobs.append(p.stdout)
        except Exception:
            pass
    try:
        with open(creds_path) as f:
            blobs.append(f.read())
    except OSError:
        pass
    for b in blobs:
        try:
            t = json.loads(b)["claudeAiOauth"]["accessToken"]
            if t:
                return t
        except Exception:
            continue
    return None


def http_get(url, headers, timeout):
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode())


def cliproxy_auth_tokens(auth_dir=AUTH_DIR, now=None):
    """Access tokens of every live (non-expired, enabled) cliproxy claude auth, newest expiry first."""
    now = now or datetime.now(timezone.utc)
    found = []
    try:
        names = sorted(n for n in os.listdir(auth_dir) if n.startswith("claude-") and n.endswith(".json"))
    except OSError:
        return []
    for n in names:
        try:
            with open(os.path.join(auth_dir, n)) as f:
                d = json.load(f)
            exp = parse_ts(d["expired"])
            if exp.tzinfo is None:
                exp = exp.replace(tzinfo=timezone.utc)
            tok = d.get("access_token")
        except Exception:
            continue
        if d.get("disabled") or not tok or exp <= now:
            continue
        found.append((exp, tok))
    found.sort(key=lambda x: x[0], reverse=True)
    return [t for _, t in found]


def cliproxy_auth_token(auth_dir=AUTH_DIR, now=None):
    """Access token of the live cliproxy claude auth with the newest expiry, else None."""
    toks = cliproxy_auth_tokens(auth_dir, now)
    return toks[0] if toks else None


def fetch_claude(token, fetch, timeout):
    try:
        body = fetch(USAGE_URL, {"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"}, timeout)
    except Exception as e:
        return blank("error", ("usage request failed: " + type(e).__name__)[:120])
    return parse_claude(body)


def used_max(r):
    return max(v for v in (r["five_hour"], r["weekly"]) if v is not None)


def claude_quota(creds_path=CREDS, use_keychain=True, fetch=http_get, timeout=6, auth_dir=AUTH_DIR):
    tokens = cliproxy_auth_tokens(auth_dir)
    if not tokens:
        token = claude_token(creds_path, use_keychain)
        if not token:
            return blank("error", "no Claude Code credentials")
        return fetch_claude(token, fetch, timeout)
    pool = ThreadPoolExecutor(max_workers=len(tokens))
    futures = [pool.submit(fetch_claude, t, fetch, timeout) for t in tokens]
    wait(futures, timeout=timeout + 1)
    results = []
    for fut in futures:
        try:
            if fut.done():
                results.append(fut.result())
        except Exception:
            pass
    pool.shutdown(wait=False, cancel_futures=True)
    ok = [r for r in results if r["source"] != "error"]
    if not ok:
        return blank("error", "usage request failed on all accounts", accounts=len(tokens), accounts_ok=0)
    best = min(ok, key=used_max)
    full = sum(1 for r in ok if used_max(r) >= 0.995)
    best["accounts"] = len(tokens)
    best["accounts_ok"] = len(ok)
    best["note"] = f"{full} of {len(tokens)} accounts full; monthly window not exposed"
    return best


# ── openrouter (metered) / xai ──────────────────────────────────────────
def openrouter_key(auth_path=None, env=os.environ):
    auth_path = auth_path or OPENCODE_AUTH
    if env.get("OPENROUTER_API_KEY"):
        return env["OPENROUTER_API_KEY"]
    try:
        with open(auth_path) as f:
            k = json.load(f)["openrouter"]["key"]
        return k or None
    except Exception:
        return None


def update_spend(prev, usage, limit_remaining, now):
    day = now.astimezone(timezone.utc).strftime("%Y-%m-%d")
    if isinstance(prev, dict) and prev.get("day") == day and isinstance(prev.get("baseline_usd"), (int, float)):
        baseline = float(prev["baseline_usd"])
    else:
        baseline = float(usage)
    return {"at": iso(now), "day": day, "baseline_usd": baseline, "usage_usd": float(usage),
            "today_usd": max(0.0, float(usage) - baseline), "limit_remaining_usd": limit_remaining}


def openrouter_quota(key=None, spend_path=SPEND_OUT, fetch=http_get, now=None, timeout=6):
    now = now or datetime.now(timezone.utc)
    key = key or openrouter_key()
    if not key:
        return blank("error", "no openrouter key")
    try:
        data = fetch(CREDITS_URL, {"Authorization": f"Bearer {key}"}, timeout)["data"]
        usage = float(data["total_usage"])
        remaining = float(data["total_credits"]) - usage if isinstance(data.get("total_credits"), (int, float)) else None
    except Exception as e:
        return blank("error", ("credits request failed: " + type(e).__name__)[:120])
    try:
        with open(spend_path) as f:
            prev = json.load(f)
    except Exception:
        prev = None
    spend = update_spend(prev, usage, remaining, now)
    try:
        write_atomic(spend_path, spend)
    except OSError as e:
        return blank("error", ("spend file write failed: " + type(e).__name__)[:120])
    return blank("api", f"metered; today ${spend['today_usd']:.2f} (UTC {spend['day']}), total ${usage:.2f}")


def xai_quota():
    return blank("none", "no read-only balance endpoint for Grok Build; a 402 in exhausted.json (launch watchdog) is the signal")


# ── openai-codex ────────────────────────────────────────────────────────
def parse_ts(s):
    return datetime.fromisoformat(str(s).replace("Z", "+00:00"))


def codex_quota(sessions_dir=CODEX, now=None):
    now = now or datetime.now(timezone.utc)
    files = []
    for root, _, names in os.walk(sessions_dir):
        files += [os.path.join(root, n) for n in names if n.endswith(".jsonl")]
    files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    for path in files[:40]:
        best = None
        try:
            with open(path, errors="replace") as f:
                for line in f:
                    if "token_count" not in line:
                        continue
                    try:
                        ev = json.loads(line)
                        rl = ev["payload"]["rate_limits"]
                        if ev["payload"].get("type") == "token_count" and rl and rl.get("primary"):
                            best = (parse_ts(ev["timestamp"]), rl)
                    except Exception:
                        continue
        except OSError:
            continue
        if best:
            ts, rl = best
            r = blank("local")
            for w in (rl.get("primary"), rl.get("secondary")):
                if not isinstance(w, dict) or not isinstance(w.get("used_percent"), (int, float)):
                    continue
                mins = w.get("window_minutes") or 0
                key = "five_hour" if 0 < mins <= 360 else "weekly" if mins >= 6000 else None
                if not key:
                    continue
                reset = w.get("resets_at")
                r["resets"][key] = iso(datetime.fromtimestamp(reset, timezone.utc)) if reset else None
                expired = reset is not None and reset < now.timestamp()
                r[key] = 0.0 if expired else frac(w["used_percent"])
            age = int((now - ts).total_seconds() // 60)
            r["note"] = f"newest rate_limits event, age {age} min; window past its reset counts as 0"
            return r
    return blank("error", "no rate_limits snapshot in codex sessions")


# ── opencode-go / commandcode: estimate from our own runs ───────────────
RUN_TS = re.compile(r"^(\d{4}-\d\d-\d\d)T(\d\d)-(\d\d)-(\d\d)-\d+Z")


def run_time(name, path):
    m = RUN_TS.match(name)
    if m:
        return datetime.fromisoformat(f"{m.group(1)}T{m.group(2)}:{m.group(3)}:{m.group(4)}+00:00")
    return datetime.fromtimestamp(os.path.getmtime(path), timezone.utc)


def estimate_quota(provider, runs_dir, caps, now=None):
    now = now or datetime.now(timezone.utc)
    cap = (caps or {}).get(provider)
    if not isinstance(cap, dict):
        return blank("error", "no quota_caps entry")
    needle = re.compile(r"(?:-m|--model) '" + re.escape(provider) + "/")
    counts = {k: 0 for k in WINDOWS}
    try:
        names = os.listdir(runs_dir)
    except OSError:
        names = []
    for name in names:
        d = os.path.join(runs_dir, name)
        script = os.path.join(d, "run.sh")
        if os.path.exists(os.path.join(d, "dry-run")) or not os.path.isfile(script):
            continue
        try:
            with open(script, errors="replace") as f:
                if not needle.search(f.read()):
                    continue
        except OSError:
            continue
        age = now - run_time(name, d)
        for k, span in WINDOWS.items():
            if age <= span:
                counts[k] += 1
    r = blank("estimate", "own jdelegate calls " + "/".join(str(counts[k]) for k in WINDOWS) + " (5h/7d/30d) over quota_caps; placeholders until set from the console")
    for k in WINDOWS:
        c = cap.get(k)
        r[k] = min(1.0, counts[k] / c) if isinstance(c, (int, float)) and c > 0 else None
    return r


# ── assemble ────────────────────────────────────────────────────────────
def build_snapshot(sources, now=None):
    now = now or datetime.now(timezone.utc)
    at = iso(now)
    out = {}
    pool = ThreadPoolExecutor(max_workers=max(1, len(sources)))
    futures = {pid: pool.submit(fn) for pid, fn in sources.items()}
    wait(list(futures.values()), timeout=TOTAL_TIMEOUT)
    for pid, fut in futures.items():
        try:
            if not fut.done():
                raise TimeoutError("timed out")
            r = fut.result()
        except Exception as e:
            r = blank("error", type(e).__name__)
        r.setdefault("resets", {})
        r["at"] = at
        out[pid] = r
    pool.shutdown(wait=False, cancel_futures=True)
    return {"at": at, "providers": out}


def write_atomic(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".quota-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def table(snap):
    pct = lambda v: "  - " if v is None else f"{round(v * 100):3d}%"
    lines = [f"quota snapshot {snap['at']}", f"{'provider':<14}{'5h':>5}{'week':>6}{'month':>6}  source    note"]
    for pid, r in snap["providers"].items():
        lines.append(f"{pid:<14}{pct(r['five_hour']):>5}{pct(r['weekly']):>6}{pct(r['monthly']):>6}  {r['source']:<9} {r['note'][:70]}")
    return "\n".join(lines)


def main(argv):
    try:
        with open(CONFIG) as f:
            caps = json.load(f).get("quota_caps", {})
    except Exception:
        caps = {}
    sources = {"cliproxy": claude_quota, "openai-codex": codex_quota, "openrouter": openrouter_quota, "xai": xai_quota}
    for p in ESTIMATED:
        sources[p] = (lambda p=p: estimate_quota(p, RUNS, caps))
    snap = build_snapshot(sources)
    if "--no-write" not in argv:
        write_atomic(OUT, snap)
    if "--print" in argv:
        print(table(snap))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
