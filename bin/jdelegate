#!/usr/bin/env node
/**
 * jdelegate — hand one self-contained job to a worker CLI on the model Jev picks,
 * in its own herdr tab, and print the worker's final answer.
 *
 *   jdelegate "<brief>"                 route, run in a new herdr tab, wait, print result
 *   jdelegate --print "<brief>"         show the routing decision only
 *   options: --cwd DIR  --name LABEL  --harness claude|codex|opencode|pi|agy  --timeout MIN (default 30)
 *            --no-tab (run inline)  --keep-tab (leave the worker tab open when it finishes)
 *            --brief-file FILE  --help
 *            --full (claude worker: all MCP servers + skills; also JDELEGATE_FULL=1)
 *            --mcp NAME (claude worker, repeatable: load only that MCP server from ~/.claude.json or <cwd>/.mcp.json)
 *            --skill NAME (claude worker, repeatable: inline that skill; looked up in ~/.claude/skills and skills-parked)
 *            --no-auto-skill (do not let Jev pick a skill; also JDELEGATE_AUTO_SKILL=0)  --dry-run (write the run dir, print run.sh, launch nothing)
 *            --role NAME (inline that agent definition from ~/.claude/agents or agents-parked under "## Role: NAME", capped 8000 chars)
 *            --no-auto-role (do not let Jev pick a role from config/worker-roles.json; also JDELEGATE_AUTO_ROLE=0)
 *            --no-auto-mcp (do not let Jev pick MCP servers when no --mcp is given; also JDELEGATE_AUTO_MCP=0)
 *
 * Lean claude workers (default; --full restores the plain `claude -p`): ~10k first-turn tokens instead of ~29k.
 * No user/project hooks, no auto-memory, no CLAUDE.md auto-discovery (~/.claude/CLAUDE.md is the orchestrator's rulebook),
 * settings from project+local only, no MCP, 6 core tools + Skill (the repo's own .claude/skills work). In their place <run>/worker-prompt.md goes in via
 * --append-system-prompt-file: a short worker contract, the git-root repo's own CLAUDE.md/AGENTS.md (never $HOME's),
 * an optional role (--role, or the one `jev choice` picks from config/worker-roles.json), and any skills (--skill, or the one
 * jev-skill-suggest picks when it is in config/worker-skills.json). With no --mcp, each configured MCP server is judged by
 * `jev noul` against the brief; at most 2 at >= 0.7 are loaded. --settings also switches commit/PR attribution off.
 *
 * The Claude Code counterpart of pi's model-router + subagents (2026-09-30):
 * Opus orchestrates, Jev decides, workers do the work. Same brain as pi:
 *   - the question is route-body.mjs (tier T0-T4, kind, thinker/doer, arabic)
 *     plus one extra noul here: is this UI work?
 *   - the model is the first live entry of the SAME tiers.json chains the pi
 *     router uses (kinds[kind][tier] then tiers[tier]), skipping dead-models.json
 *     and exhausted.json, subscription providers first, metered last;
 *   - the provider decides the worker: cliproxy -> `claude`, openai-codex ->
 *     `codex exec`, opencode-go -> `opencode run`, everything else (commandcode,
 *     openrouter) -> bare `pi`; UI work -> `agy` (owner rule: all
 *     UI implementation goes through agy).
 * Inside herdr the worker runs in a new tab (label "name · model") so the owner
 * can watch it; outside herdr it runs inline. The worker never inherits
 * CLAUDE_ORCH, so a Claude worker is not blocked from editing.
 * Decisions are logged under jev tag `router-delegate`.
 */
import { spawn, spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { existsSync, mkdirSync, readFileSync, readdirSync, realpathSync, renameSync, statSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";

const HOME = homedir();
const { buildRouteBody, buildOutputBody, parseRoute, parseIds } = await import(`${HOME}/.pi/agent/extensions/model-router/route-body.mjs`);
const readJson = (p) => { try { return JSON.parse(readFileSync(p, "utf8")); } catch { return undefined; } };
const CONFIG = readJson(process.env.JEV_ROUTER_CONFIG ?? `${HOME}/.config/jev-router/tiers.json`) ?? {};
const DEAD = readJson(`${HOME}/.config/jev-router/dead-models.json`) ?? {};
const EXHAUSTED_FILE = process.env.JEV_EXHAUSTED_FILE || `${HOME}/.config/jev-router/exhausted.json`;
const EXHAUSTED = readJson(EXHAUSTED_FILE) ?? {};
const JEV = process.env.JDELEGATE_JEV || ([`${HOME}/.local/bin/jev`, "/usr/local/bin/jev"].find(existsSync) ?? "jev");
const CACHE = process.env.JDELEGATE_CACHE || join(HOME, ".cache", "jdelegate");
const SKILL_DIRS = (process.env.JDELEGATE_SKILL_DIRS || `${HOME}/.claude/skills:${HOME}/.claude/skills-parked`).split(":").filter(Boolean);
const WORKER_SKILLS = process.env.JDELEGATE_WORKER_SKILLS || join(dirname(realpathSync(process.argv[1])), "..", "config", "worker-skills.json");
const AGENT_DIRS = (process.env.JDELEGATE_AGENT_DIRS || `${HOME}/.claude/agents:${HOME}/.claude/agents-parked`).split(":").filter(Boolean);
const WORKER_ROLES = process.env.JDELEGATE_WORKER_ROLES || join(dirname(realpathSync(process.argv[1])), "..", "config", "worker-roles.json");
const CLAUDE_JSON = process.env.JDELEGATE_CLAUDE_JSON || `${HOME}/.claude.json`;
const DEBUG = process.env.JDELEGATE_DEBUG === "1";
/** JDELEGATE_DEBUG=1: print how long a selection step took, on stderr. */
const timed = (label, fn) => { const t = Date.now(); const out = fn(); const done = () => DEBUG && console.error(`[jdelegate:timing] ${label} ${Date.now() - t}ms`); return out instanceof Promise ? out.finally(done) : (done(), out); };
/** Async spawn with a kill timeout. Never rejects; resolves {status, stdout, stderr} like spawnSync (status null on timeout or spawn error). */
const runCmd = (cmd, args, { input, timeout = 8000 } = {}) => new Promise((done) => {
  let out = "", err = "", settled = false, timer;
  const finish = (status) => { if (settled) return; settled = true; clearTimeout(timer); done({ status, stdout: out, stderr: err }); };
  let c;
  try { c = spawn(cmd, args, { stdio: ["pipe", "pipe", "pipe"] }); } catch { return finish(null); }
  timer = setTimeout(() => { c.kill("SIGKILL"); finish(null); }, timeout);
  c.stdout.on("data", (b) => { out += b; });
  c.stderr.on("data", (b) => { err += b; });
  c.on("error", () => finish(null));
  c.on("close", (code) => finish(code));
  c.stdin.on("error", () => {});
  c.stdin.end(input ?? "");
});
const SECTION_CAP = 12000;
const ROLE_CAP = 8000;
const AGY_RELAY = process.env.JDELEGATE_AGY_RELAY || `${HOME}/.claude/skills/agy-delegate/scripts/relay.mjs`;
const AGY_EXHAUSTED_FILE = process.env.JDELEGATE_AGY_EXHAUSTED_FILE || join(HOME, ".cache", "jev-router", "agy-exhausted.json");
const AGY_QUOTA_DEFAULT_MS = 6 * 36e5;
const TIERS = ["T0", "T1", "T2", "T3", "T4"];
const THINK = ["off", "minimal", "low", "medium", "high"];

// ── args ────────────────────────────────────────────────────────────────
const argv = process.argv.slice(2);
const USAGE = 'usage: jdelegate [--cwd DIR] [--name LABEL] [--harness claude|codex|opencode|pi|agy] [--timeout MIN] [--no-tab] [--keep-tab] [--full] [--mcp NAME]... [--skill NAME]... [--no-auto-skill] [--role NAME] [--no-auto-role] [--no-auto-mcp] [--dry-run] [--print] "<brief>"\n  claude workers are lean by default: no hooks, no auto-memory, no ~/.claude/CLAUDE.md, no MCP servers, 6 core tools + Skill (~10k vs ~43k first-turn tokens).\n  Sonnet/Haiku claude workers get the Opus advisor (--advisor opus; JDELEGATE_ADVISOR=0 turns it off, JDELEGATE_ADVISOR=<model> picks another).\n  They get <run>/worker-prompt.md instead: a worker contract + the repo\'s own CLAUDE.md/AGENTS.md + inlined skills.\n  --full or JDELEGATE_FULL=1 restores the plain claude; --mcp NAME loads just that one MCP server.\n  --skill NAME inlines that skill (~/.claude/skills or skills-parked; unknown name exits 2). With no --skill, Jev may pick one from config/worker-skills.json; --no-auto-skill or JDELEGATE_AUTO_SKILL=0 turns that off.\n  --role NAME inlines that agent definition (~/.claude/agents or agents-parked; unknown name exits 2). With no --role, Jev may pick one from config/worker-roles.json or none; --no-auto-role or JDELEGATE_AUTO_ROLE=0 turns that off.\n  With no --mcp, Jev judges each configured MCP server (~/.claude.json, project entry, <cwd>/.mcp.json) against the brief and loads at most 2; --no-auto-mcp or JDELEGATE_AUTO_MCP=0 turns that off.\n  Lean workers also have commit/PR attribution switched off.\n  --dry-run writes the run dir and prints run.sh without launching.';
const opt = { cwd: process.cwd(), name: "", harness: "", timeout: 30, tab: true, print: false, noEscalate: false, keepTab: false, full: process.env.JDELEGATE_FULL === "1", mcp: [], skills: [], autoSkill: process.env.JDELEGATE_AUTO_SKILL !== "0", role: "", autoRole: process.env.JDELEGATE_AUTO_ROLE !== "0", autoMcp: process.env.JDELEGATE_AUTO_MCP !== "0", dryRun: false, gc: false, older: 60, brief: "" };
// JDELEGATE_TIMEOUT_MS overrides --timeout for tests (and fine-grained timeouts in general). opt.timeout stays in minutes for the help text.
const TIMEOUT_OVERRIDE_MS = process.env.JDELEGATE_TIMEOUT_MS ? Number(process.env.JDELEGATE_TIMEOUT_MS) : undefined;
const timeoutMs = () => TIMEOUT_OVERRIDE_MS ?? Math.max(1, opt.timeout) * 60_000;
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === "--cwd") opt.cwd = resolve(argv[++i]);
  else if (a === "--name") opt.name = argv[++i];
  else if (a === "--harness") opt.harness = argv[++i];
  else if (a === "--timeout") opt.timeout = Number(argv[++i]);
  else if (a === "--no-tab") opt.tab = false;
  else if (a === "--keep-tab") opt.keepTab = true;
  else if (a === "--help" || a === "-h") { console.log(USAGE); process.exit(0); }
  else if (a === "--full") opt.full = true;
  else if (a === "--mcp") opt.mcp.push(argv[++i]);
  else if (a === "--skill") opt.skills.push(argv[++i]);
  else if (a === "--no-auto-skill") opt.autoSkill = false;
  else if (a === "--role") opt.role = argv[++i] ?? "";
  else if (a === "--no-auto-role") opt.autoRole = false;
  else if (a === "--no-auto-mcp") opt.autoMcp = false;
  else if (a === "--dry-run") opt.dryRun = true;
  else if (a === "--no-escalate") opt.noEscalate = true;
  else if (a === "--gc") opt.gc = true;
  else if (a === "--older") opt.older = Number(argv[++i]);
  else if (a === "--print") opt.print = true;
  else if (a === "--brief-file") opt.brief = readFileSync(argv[++i], "utf8");
  else opt.brief = opt.brief ? `${opt.brief} ${a}` : a;
}
if (argv[0] === "wait") {
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const names = argv.slice(1).filter((a) => !a.startsWith("--"));
  if (!names.length) { console.error("usage: jdelegate wait <run-dir-or-name>..."); process.exit(2); }
  const resolveRun = (n) => {
    if (existsSync(join(n, "run.sh"))) return resolve(n);
    const hits = existsSync(CACHE) ? readdirSync(CACHE).filter((d) => d === n || d.includes(`-${n}-`)).sort() : [];
    return hits.length ? join(CACHE, hits[hits.length - 1]) : undefined;
  };
  const runs = names.map((n) => ({ n, run: resolveRun(n) }));
  const missing = runs.filter((r) => !r.run);
  if (missing.length) { console.error(`jdelegate wait: no run found for ${missing.map((r) => r.n).join(", ")}`); process.exit(2); }
  const limit = Date.now() + (TIMEOUT_OVERRIDE_MS ?? ((argv.includes("--timeout") ? Number(argv[argv.indexOf("--timeout") + 1]) : opt.timeout) * 60_000));
  let rcAll = 0;
  for (const { n, run } of runs) {
    while (!existsSync(join(run, "exit"))) {
      if (Date.now() > limit) { console.log(`=== ${n} (${run})\nstill running`); rcAll = 124; break; }
      await sleep(500);
    }
    if (!existsSync(join(run, "exit"))) continue;
    const rc = Number(readFileSync(join(run, "exit"), "utf8").trim()) || 0;
    const read = (f) => { try { return readFileSync(join(run, f), "utf8"); } catch { return ""; } };
    const text = read("final.txt").trim() || read("out.log").trim() || read("err.log").trim();
    console.log(`=== ${n} (${run})\nexit ${rc}\n${text.split("\n").slice(-40).join("\n")}`);
    if (rc !== 0 && rcAll === 0) rcAll = rc;
  }
  process.exit(rcAll);
}
if (opt.gc) {
  const root = CACHE;
  let closed = 0;
  const runs = [];
  const findRuns = (dir) => {
    for (const name of readdirSync(dir, { withFileTypes: true })) {
      const path = join(dir, name.name);
      if (name.isDirectory()) findRuns(path);
      else if (name.name === "tab") runs.push(dir);
    }
  };
  if (existsSync(root)) findRuns(root);
  for (const run of runs) {
    const exitFile = join(run, "exit"), tabFile = join(run, "tab");
    try {
      if (!existsSync(tabFile) || !existsSync(exitFile)) continue;
      if (Date.now() - statSync(exitFile).mtimeMs < opt.older * 60_000) continue;
      const tab = readFileSync(tabFile, "utf8").trim();
      if (!tab) continue;
      const result = spawnSync("herdr", ["tab", "close", tab], { encoding: "utf8", timeout: 8000 });
      if (result.status !== 0) continue;
      unlinkSync(tabFile);
      closed++;
    } catch { /* stale or incomplete run directory */ }
  }
  console.log(`Closed ${closed} herdr tab${closed === 1 ? "" : "s"}.`);
  process.exit(0);
}
if (!opt.brief.trim()) {
  console.error(USAGE);
  process.exit(2);
}

// ── skills and repo instructions for the lean claude worker ─────────────
const cap = (text, what) => (text.length > SECTION_CAP ? `${text.slice(0, SECTION_CAP)}\n[... ${what} truncated at ${SECTION_CAP} chars]` : text);
function readSkill(name) {
  for (const dir of SKILL_DIRS) {
    try { return readFileSync(join(dir, name, "SKILL.md"), "utf8").replace(/^---\r?\n[\s\S]*?\r?\n---[ \t]*(\r?\n|$)/, "").trim(); } catch { /* next root */ }
  }
  return undefined;
}
const explicitSkills = opt.skills.map((name) => {
  const body = /^[\w.-]+$/.test(name ?? "") ? readSkill(name) : undefined;
  if (body === undefined) { console.error(`jdelegate: skill "${name}" not found in ${SKILL_DIRS.join(", ")}`); process.exit(2); }
  return { name, body, auto: false };
});
/** Jev's suggestion for the brief (the raw name). ok is false when the suggester failed. Never throws, never blocks past 8 s. */
async function suggestSkill(brief) {
  const r = await runCmd("jev-skill-suggest", ["--name", brief.slice(0, 2000)]);
  return { ok: r.status === 0, name: r.status === 0 ? r.stdout.trim() : "" };
}
/** The suggested skill, only if it is on the worker allowlist. */
function skillFor(name) {
  try {
    if (!name || !/^[\w.-]+$/.test(name)) return [];
    if (!(readJson(WORKER_SKILLS)?.worker ?? []).includes(name)) return [];
    const body = readSkill(name);
    return body === undefined ? [] : [{ name, body, auto: true }];
  } catch { return []; }
}
const stripFrontmatter = (t) => t.replace(/^---\r?\n[\s\S]*?\r?\n---[ \t]*(\r?\n|$)/, "").trim();
function readAgent(name) {
  if (!/^[\w.-]+$/.test(name ?? "")) return undefined;
  for (const dir of AGENT_DIRS) {
    try { const raw = readFileSync(join(dir, `${name}.md`), "utf8"); return { body: stripFrontmatter(raw), description: raw.match(/^description:[ \t]*(.*)$/m)?.[1]?.trim() ?? "" }; } catch { /* next root */ }
  }
  return undefined;
}
let explicitRole;
if (opt.role) {
  const a = readAgent(opt.role);
  if (!a) { console.error(`jdelegate: role "${opt.role}" not found in ${AGENT_DIRS.join(", ")}`); process.exit(2); }
  explicitRole = { name: opt.role, body: a.body, auto: false };
}
/** The role question over config/worker-roles.json plus "none", or undefined when no role is eligible. Never throws. */
function roleQuestion() {
  try {
    const eligible = (readJson(WORKER_ROLES)?.worker ?? []).filter((n) => /^[\w.-]+$/.test(n));
    const found = eligible.map((name) => ({ name, agent: readAgent(name) })).filter((r) => r.agent);
    if (!found.length) return undefined;
    const criteria = Object.fromEntries([...found.map((r) => [r.name, r.agent.description.replace(/\s+/g, " ").slice(0, 200) || null]), ["none", "No specialist role; a generic worker fits."]]);
    return { found, question: { type: "choice", instructions: "Which specialist role, if any, fits the worker doing this coding brief? Pick none for a generic worker.", criteria } };
  } catch { return undefined; }
}
const roleOf = (found, name) => { const hit = found.find((f) => f.name === name); return hit ? { name, body: hit.agent.body, auto: true } : undefined; };
/** jev choice --min 0.6: a missing or lower confidence means no role. Returns undefined for a malformed answer, {name} otherwise (name null = none). */
function parseRole(a, found) {
  if (typeof a?.choice !== "string") return undefined;
  const name = typeof a.confidence === "number" && a.confidence >= 0.6 && roleOf(found, a.choice) ? a.choice : null;
  return { name };
}
const SPAWNS = /\b(spawn\w*|delegat\w*|orchestrat\w*|sub-?agents?)\b|\b(Agent|Task) tool\b/i;
function roleSection(role) {
  const body = role.body.length > ROLE_CAP ? `${role.body.slice(0, ROLE_CAP)}\n[... role ${role.name} truncated at ${ROLE_CAP} chars]` : role.body;
  const override = SPAWNS.test(body) ? "\nYou are running as a single worker: ignore any instruction above to spawn agents or delegate." : "";
  return `## Role: ${role.name}\n${body}${override}`;
}
function repoInstructions() {
  const top = spawnSync("git", ["-C", opt.cwd, "rev-parse", "--show-toplevel"], { encoding: "utf8", timeout: 5000 }).stdout?.trim();
  if (!top) return "";
  try { if (realpathSync(top) === realpathSync(HOME)) return ""; } catch { return ""; }
  const parts = ["CLAUDE.md", "AGENTS.md", ".claude/CLAUDE.md"].flatMap((f) => {
    try { return [`### ${f}\n${readFileSync(join(top, f), "utf8").trim()}`]; } catch { return []; }
  });
  return parts.length ? cap(parts.join("\n\n"), "repo instructions") : "";
}
const CONTRACT = `You are a worker. An orchestrator already did the KB research, spec, task logging and delegation for this job.
- Do not run kb-*, speckit or deploy pipelines, do not spawn agents, do not look for MCP tools.
- Stay inside the scope of the brief.
- When you change behaviour, write the failing test first.
- Never add Co-Authored-By or "Generated with" lines to a commit. Commit only if the brief says so.
- Your final answer is: what changed, pasted command output as evidence, and what you could not do.
Plain direct prose, no emoji.`;
// KB prior art: Jev-screened, Haiku-condensed matches from the project KB in --cwd (bin/kb-retrieve --condense; falls back to the keyword matches). Empty when none match, on error, or with JDELEGATE_KB=0.
const KB_RETRIEVE = process.env.DEVSTACK_KB_RETRIEVE_BIN || join(dirname(realpathSync(process.argv[1])), "kb-retrieve");
let kbPriorArtText;
function kbPriorArt() {
  if (process.env.JDELEGATE_KB === "0") return "";
  if (kbPriorArtText === undefined) {
    const r = spawnSync(KB_RETRIEVE, ["--root", opt.cwd, "--condense", "--", opt.brief.slice(0, 2000)], { encoding: "utf8", timeout: 50000 });
    kbPriorArtText = r.status === 0 ? r.stdout.trim() : "";
  }
  return kbPriorArtText;
}
function workerPrompt(skills, role) {
  const repo = repoInstructions();
  const kb = kbPriorArt();
  return [CONTRACT, repo && `## Repo instructions\n${repo}`, role && roleSection(role), ...skills.map((s) => `## Skill: ${s.name}\n${cap(s.body, `skill ${s.name}`)}`), kb && `## KB prior art\n${cap(kb, "KB prior art")}`].filter(Boolean).join("\n\n") + "\n";
}

// The human label (herdr tab title, echo lines) may be anything; the slug is what lands in a directory name.
const slugOf = (s) => String(s).replace(/[^\w.-]/g, "").slice(0, 24) || "job";
opt.name ||= opt.brief.replace(/\s+/g, " ").trim().split(" ").slice(0, 4).join("-");
const nameLabel = opt.name.replace(/[\x00-\x1f\x7f]+/g, " ").trim() || "job";
const nameSlug = slugOf(opt.name);

// ── 1. jev decides ──────────────────────────────────────────────────────
async function decide(brief) {
  const body = buildRouteBody({ prompt: brief });
  body.questions.ui = {
    type: "noul",
    instructions:
      "The work builds or changes a user interface: pages, components, layout, styling, visual design " +
      "or animation — frontend code whose main outcome is how it looks or feels.",
  };
  const started = Date.now();
  const r = await runCmd(JEV, ["raw", "--log", "router-delegate"], { input: JSON.stringify(body) });
  const id = parseIds(r.stderr).tier;
  const ms = Date.now() - started;
  try {
    if (r.status !== 0) throw new Error(`jev exit ${r.status}`);
    const a = parseRoute(r.stdout);
    const answers = JSON.parse(r.stdout).answers ?? {};
    const ui = Number(answers.ui?.noul ?? 0) || 0;
    let tier = TIERS.includes(a.tier) ? a.tier : "T3";
    if (a.tierConf < 0.4) tier = TIERS[Math.min(3, TIERS.indexOf(tier) + 1)];
    // Long multi-requirement briefs were rated T2 ("one file") and went to the cheapest model (2026-09-30).
    if (brief.length > 1500 && ["T0", "T1", "T2"].includes(tier)) tier = "T3";
    let kind = ["general", "code", "reasoning", "agentic", "vision", "language"].includes(a.kind) ? a.kind : "general";
    if ((Number(a.arabic) || 0) >= 0.6 && !["code", "agentic", "vision"].includes(kind)) kind = "language";
    const role = a.role === "thinker" ? "thinker" : "doer";
    if (role === "thinker" && (kind === "general" || kind === "code")) kind = "reasoning";
    return { tier, kind, role, conf: a.tierConf, ui, ms, failed: false, id };
  } catch (e) {
    return { tier: "T3", kind: "code", role: "doer", conf: 0, ui: 0, ms, failed: true, id, error: String(e.message ?? e) };
  }
}

// ── 2. same chains as the pi router ─────────────────────────────────────
const METERED = new Set(CONFIG.metered_providers ?? ["openrouter"]);
const PRIORITY = CONFIG.provider_priority ?? { cliproxy: 0, "openai-codex": 0, "opencode-go": 1, commandcode: 2, openrouter: 3 };
const provider = (ref) => ref.slice(0, ref.indexOf("/"));
const alive = (ref) => {
  const now = Date.now();
  return !(DEAD[ref] > now) && !(EXHAUSTED[provider(ref)] > now);
};
/** Provider -> worker CLI. Small OpenCode Go models run in opencode itself; pi takes the rest. */
const harnessFor = (ref) =>
  ({ cliproxy: "claude", "openai-codex": "codex", "opencode-go": "opencode" })[provider(ref)] ?? "pi";

// Quota-aware ranking (tiers.json quota_policy + bin/quota-snapshot). No quota_policy -> the static ranking above.
const POLICY = CONFIG.quota_policy;
const QUOTA_FILE = process.env.JEV_QUOTA_FILE || join(HOME, ".cache", "jev-router", "quota.json");
const QUOTA_SNAPSHOT = process.env.JDELEGATE_QUOTA_SNAPSHOT || join(dirname(realpathSync(process.argv[1])), "quota-snapshot");
const WINDOW_LABEL = { five_hour: "5h", weekly: "weekly", monthly: "monthly" };
let quotaMemo;
/** The quota file, refreshed synchronously (4 s cap) when older than stale_minutes; a stale or missing file is kept when the refresh fails. */
function loadQuota() {
  if (!POLICY) return undefined;
  if (quotaMemo !== undefined) return quotaMemo || undefined;
  const fresh = (j) => j?.providers && Date.now() - Date.parse(j.at) <= (POLICY.stale_minutes ?? 20) * 60_000;
  let j = readJson(QUOTA_FILE);
  if (!fresh(j)) {
    try { spawnSync(QUOTA_SNAPSHOT, [], { timeout: 4000, stdio: "ignore", env: { ...process.env, QUOTA_SNAPSHOT_OUT: QUOTA_FILE } }); } catch { /* keep the stale file */ }
    j = readJson(QUOTA_FILE) ?? j;
  }
  quotaMemo = j?.providers ? j.providers : null;
  return quotaMemo || undefined;
}
/** Used fractions of a provider's known windows, or undefined when nothing is known. */
function windowsOf(quota, prov) {
  const e = quota?.[prov];
  if (!e || e.source === "error") return undefined;
  const w = Object.keys(WINDOW_LABEL).filter((k) => typeof e[k] === "number").map((k) => [k, e[k]]);
  return w.length ? w : undefined;
}
function bucketOf(ref, quota) {
  const prov = provider(ref);
  if (METERED.has(prov)) return { bucket: 9 };
  const w = windowsOf(quota, prov);
  if (!w) return { bucket: PRIORITY[prov] ?? 2 };
  const top = Math.max(...w.map(([, f]) => f));
  const bucket = top >= (POLICY.hot ?? 0.9) ? 3 : top >= (POLICY.warm ?? 0.7) ? 2 : 0;
  const driven = w.filter(([, f]) => f >= (POLICY.warm ?? 0.7)).map(([k, f]) => `${WINDOW_LABEL[k]} ${Math.round(f * 100)}%`);
  return { bucket, note: bucket ? `${prov} ${driven.join(", ")} → demoted` : undefined };
}

/** opencode workers have no usable shell: a brief that commits, runs tests, lints or calls bash goes to a shell-capable harness. */
const needsShell = (brief) => /\bgit\s+(commit|push|merge|rebase|checkout|add)\b|\b(commit|run(ning)?\s+(the\s+|all\s+|our\s+)?(unit\s+|e2e\s+)?tests?|test\s+suite|lint(er|ing)?|bash|shell|npm\s+(test|run)|pytest|phpunit|cargo\s+test)\b/i.test(brief);

/** Owner rule 2026-10-07: computer use, browser/e2e/playwright, running tests and QA run on kinds.test (Haiku 5.5). */
const isTestWork = (brief, role) => role === "qa-engineer" || /\b(computer[- ]use|browser|e2e|end[- ]to[- ]end|playwright|puppeteer|cypress|selenium|qa|run(ning)?\s+(the\s+|all\s+|our\s+)?(unit\s+|e2e\s+|integration\s+)?tests?|test\s+suite)\b/i.test(brief);

/** Epoch ms until which agy is out of quota per agy-exhausted.json, or 0 when the file is absent, unreadable or expired. */
function agyExhaustedUntil() {
  const t = Date.parse(readJson(AGY_EXHAUSTED_FILE)?.until);
  return t > Date.now() ? t : 0;
}
/** Ms until agy works again from an agy quota error text ("Individual quota reached ... Resets in 56h40m51s."); undefined when the text is not a quota error. */
function agyQuotaResetMs(text) {
  if (!/RESOURCE_EXHAUSTED|quota reached/i.test(text)) return undefined;
  const m = text.match(/Resets? in\s+(?:(\d+)\s*d)?\s*(?:(\d+)\s*h)?\s*(?:(\d+)\s*m(?!s))?\s*(?:(\d+)\s*s)?/i);
  const ms = m ? ((+m[1] || 0) * 864e5 + (+m[2] || 0) * 36e5 + (+m[3] || 0) * 6e4 + (+m[4] || 0) * 1e3) : 0;
  return ms > 0 ? ms : AGY_QUOTA_DEFAULT_MS;
}
/** An agy worker that hit its quota: record agy as exhausted until the printed reset so every later run routes UI work to claude. Returns true when it did. */
function markAgyExhausted(attemptP, run) {
  if (attemptP.harness !== "agy") return false;
  const read = (f) => { try { return readFileSync(join(run, f), "utf8"); } catch { return ""; } };
  const ms = agyQuotaResetMs([read("agy/stderr.txt"), read("agy/result.json"), read("out.log")].join("\n"));
  if (ms === undefined) return false;
  try {
    mkdirSync(dirname(AGY_EXHAUSTED_FILE), { recursive: true });
    writeFileSync(AGY_EXHAUSTED_FILE, JSON.stringify({ until: new Date(Date.now() + ms).toISOString(), seen: new Date().toISOString() }, null, 2));
  } catch { /* the retry on claude does not depend on the file */ }
  return true;
}

/** noAgy: the agy lane is unusable (quota) for this pick, whatever --harness said. */
function pick(d, { noAgy = false } = {}) {
  const thinkIdx = Math.max(0, THINK.indexOf(CONFIG.thinking?.[d.tier] ?? "medium"));
  const thinking = THINK[Math.min(THINK.length - 1, d.role === "thinker" ? Math.max(thinkIdx + 1, 2) : thinkIdx)];
  const uiWork = !opt.harness && d.ui >= 0.7 && (d.kind === "code" || d.kind === "general");
  const agyUntil = uiWork && !noAgy ? agyExhaustedUntil() : 0;
  if (!noAgy && !agyUntil && (opt.harness === "agy" || uiWork)) {
    return { harness: "agy", ref: `agy/${CONFIG.agy_model ?? "gemini-3.8-flash-high"}`, thinking, why: `UI work (ui ${d.ui.toFixed(2)}) → agy` };
  }
  const chain = [...new Set([...(CONFIG.kinds?.[d.kind]?.[d.tier] ?? []), ...(CONFIG.tiers?.[d.tier] ?? [])])];
  const quota = loadQuota();
  const scored = chain
    .filter(alive)
    .map((ref, i) => quota
      ? { ref, i, ...bucketOf(ref, quota) }
      : { ref, i, bucket: METERED.has(provider(ref)) ? 3 : (PRIORITY[provider(ref)] ?? 2) })
    .sort((x, y) => x.bucket - y.bucket || x.i - y.i)
    .filter((x) => noAgy || !opt.harness || harnessFor(x.ref) === opt.harness)
    .filter((x) => !(needsShell(opt.brief) && harnessFor(x.ref) === "opencode"));
  const ranked = scored.map((x) => x.ref);
  const demoted = [...new Set(scored.map((x) => x.note).filter(Boolean))];
  const ref = ranked[0];
  if (!ref) return undefined;
  const agyNote = agyUntil ? `agy quota exhausted until ${new Date(agyUntil).toISOString()} → claude; ` : "";
  return { harness: harnessFor(ref), ref, thinking, why: `${agyNote}${d.kind}·${d.tier} chain, first live${demoted.length ? `; quota: ${demoted.join("; ")}` : ""}` };
}

// ── 3. worker command ───────────────────────────────────────────────────
const q = (s) => `'${String(s).replace(/'/g, `'\\''`)}'`;
/** Every MCP server the worker could load: ~/.claude.json, this cwd's project entry, <cwd>/.mcp.json (on a name clash ~/.claude.json wins). */
function configuredMcp() {
  const user = readJson(CLAUDE_JSON);
  return { ...readJson(join(opt.cwd, ".mcp.json"))?.mcpServers, ...user?.projects?.[opt.cwd]?.mcpServers, ...user?.mcpServers };
}
/**
 * Servers auto-selection may consider: {name: {def, trusted}}. ~/.claude.json and this cwd's project entry are the user's own;
 * a <cwd>/.mcp.json server counts only when the project entry lists it in enabledMcpjsonServers (and not in disabledMcpjsonServers).
 */
function autoMcpServers() {
  const user = readJson(CLAUDE_JSON), proj = user?.projects?.[opt.cwd];
  const out = {};
  const enabled = Array.isArray(proj?.enabledMcpjsonServers) ? proj.enabledMcpjsonServers : [];
  const disabled = Array.isArray(proj?.disabledMcpjsonServers) ? proj.disabledMcpjsonServers : [];
  const fromFile = readJson(join(opt.cwd, ".mcp.json"))?.mcpServers;
  for (const [name, def] of Object.entries(fromFile && typeof fromFile === "object" ? fromFile : {}))
    if (enabled.includes(name) && !disabled.includes(name)) out[name] = { def, trusted: false };
  for (const [name, def] of Object.entries({ ...proj?.mcpServers, ...user?.mcpServers })) out[name] = { def, trusted: true };
  return out;
}
/** The MCP questions, one noul per auto-selectable server: {name: question}. Untrusted (.mcp.json) servers: name + command only. */
function mcpQuestions() {
  const qs = {};
  try {
    for (const [name, { def, trusted }] of Object.entries(autoMcpServers())) {
      const what = trusted ? def?.description || [def?.command ?? def?.url, ...(def?.args ?? [])].filter(Boolean).join(" ") : String(def?.command ?? def?.url ?? "").slice(0, 200);
      qs[`mcp:${name}`] = { type: "noul", instructions: `This coding brief needs the ${name} MCP server (${what})` };
    }
  } catch { /* none */ }
  return qs;
}
/** Servers whose probability is >= 0.7, best first, at most 2. A malformed answer drops only that server. */
function parseMcp(answers, qs) {
  const scored = [];
  for (const key of Object.keys(qs)) {
    const prob = typeof answers?.[key]?.noul === "number" ? answers[key].noul : NaN;
    if (prob >= 0.7) scored.push({ name: key.slice(4), prob });
  }
  return scored.sort((x, y) => y.prob - x.prob).slice(0, 2).map((x) => x.name);
}
/** One `jev raw` request for several questions over the same state (the brief, parsed like `jev -s`). Undefined on any failure. */
async function askFolded(brief, questions) {
  if (!Object.keys(questions).length) return undefined;
  const text = brief.slice(0, 2000);
  let state = text;
  try { const v = JSON.parse(text); if (v && typeof v === "object") state = v; } catch { /* plain text */ }
  const r = await runCmd(JEV, ["raw"], { input: JSON.stringify({ state, questions }) });
  if (r.status !== 0) return undefined;
  try { const a = JSON.parse(r.stdout).answers; return a && typeof a === "object" ? a : undefined; } catch { return undefined; }
}
let mcpNames = opt.mcp;
function leanMcpConfig() {
  const servers = {};
  for (const name of mcpNames) {
    const def = configuredMcp()[name];
    if (!def) { console.error(`jdelegate: MCP server "${name}" not found in ${CLAUDE_JSON} or ${opt.cwd}/.mcp.json`); process.exit(2); }
    servers[name] = def;
  }
  return JSON.stringify({ mcpServers: servers });
}
const isLean = () => !(opt.full && !opt.mcp.length);
let workerSkills = [];
let workerRole;
// Owner decision 2026-10-08: Sonnet/Haiku claude workers get the Opus advisor (claude --advisor, docs: code.claude.com/docs/en/advisor).
// JDELEGATE_ADVISOR=0 turns it off; JDELEGATE_ADVISOR=<model> picks another advisor.
function advisorFlag(id) {
  const env = (process.env.JDELEGATE_ADVISOR ?? "").trim();
  if (env === "0" || !/sonnet|haiku/i.test(id)) return "";
  return ` --advisor ${env.replace(/[^\w./-]/g, "") || "opus"}`;
}
function workerScript(p, run, briefFile) {
  const id = p.ref.slice(p.ref.indexOf("/") + 1);
  const effortClaude = { off: "low", minimal: "low", low: "low", medium: "medium", high: "high" }[p.thinking];
  const effortCodex = { off: "low", minimal: "low", low: "low", medium: "medium", high: "high" }[p.thinking];
  switch (p.harness) {
    case "claude":
      if (!isLean())
        return `claude -p --model ${q(id)} --effort ${effortClaude}${advisorFlag(id)} --dangerously-skip-permissions "$(cat ${q(briefFile)})" </dev/null 2>&1 | tee ${q(join(run, "out.log"))}`;
      // lean: brief on stdin (variadic --tools would swallow a trailing prompt argument). No CLAUDE.md files, no user
      // settings, no hooks, no auto-memory; the worker's context is <run>/worker-prompt.md. (--bare would break OAuth login.)
      // Skill tool on: the repo's own .claude/skills (project settings) stay reachable; slash commands stay off.
      // disableBundledSkills: with the Skill tool on, ~19 bundled Claude Code skills added ~3k first-turn tokens.
      return `cat ${q(briefFile)} | CLAUDE_CODE_DISABLE_CLAUDE_MDS=1 claude -p --model ${q(id)} --effort ${effortClaude}${advisorFlag(id)} --dangerously-skip-permissions --setting-sources project,local --settings ${q('{"disableAllHooks":true,"autoMemoryEnabled":false,"includeCoAuthoredBy":false,"attribution":{"commit":"","pr":""},"disableBundledSkills":true}')} --append-system-prompt-file ${q(join(run, "worker-prompt.md"))} --strict-mcp-config --mcp-config ${q(join(run, "mcp.json"))} --exclude-dynamic-system-prompt-sections --tools Bash Read Edit Write Glob Grep Skill 2>&1 | tee ${q(join(run, "out.log"))}`;
    case "codex":
      return `codex exec -m ${q(id)} -C ${q(opt.cwd)} --skip-git-repo-check -s workspace-write -c model_reasoning_effort=${q(`"${effortCodex}"`)} -o ${q(join(run, "final.txt"))} "$(cat ${q(briefFile)})" </dev/null 2>&1 | tee ${q(join(run, "out.log"))}`;
    case "agy":
      return `node ${q(AGY_RELAY)} --brief ${q(briefFile)} --cd ${q(opt.cwd)} --model ${q(id)} --dangerously-skip-permissions --out-dir ${q(join(run, "agy"))} 2>&1 | tee ${q(join(run, "out.log"))}`;
    case "opencode": {
      // JSON events to a file for the answer; a readable stream in the tab.
      const show =
        'if .type == "text" then "🤖 " + (.part.text // "") ' +
        'elif .type == "tool_use" then "🔧 " + (.part.tool // "tool") + " " + ((.part.state.input // {}) | tostring | .[0:140]) ' +
        'elif .type == "error" then "✗ " + (.error | tostring | .[0:200]) else empty end';
      return `opencode run -m ${q(p.ref)} --dir ${q(opt.cwd)} --auto --format json "$(cat ${q(briefFile)})" </dev/null 2>${q(join(run, "err.log"))} | tee ${q(join(run, "out.jsonl"))} | jq --unbuffered -rR ${q(`fromjson? | ${show}`)} | tee ${q(join(run, "out.log"))}`;
    }
    default: {
      // Bare pi, like software-factory's lib/agent.py: with extensions loaded the
      // router took over the worker (switched it to Opus) and pi never exited;
      // the global AGENTS.md also tells every model it is the orchestrator.
      const view = `${HOME}/.local/bin/pi-sub-view`;
      return [
        `pi --mode json -p --no-extensions --no-context-files --no-skills --model ${q(p.ref)} --thinking ${p.thinking} --session-dir ${q(join(run, "sessions"))} "$(cat ${q(briefFile)})" </dev/null > ${q(join(run, "out.jsonl"))} 2>${q(join(run, "err.log"))} & PI=$!`,
        `until ls ${q(join(run, "sessions"))}/*.jsonl >/dev/null 2>&1 || ! kill -0 $PI 2>/dev/null; do sleep 0.5; done`,
        `S=$(ls ${q(join(run, "sessions"))}/*.jsonl 2>/dev/null | head -1); [ -n "$S" ] && { ${q(view)} "$S" ${q(opt.name)} & V=$!; }`,
        `wait $PI; RC=$?; sleep 1; [ -n "$V" ] && kill $V 2>/dev/null`,
        `jq -rs ${q('[.[] | select(.type == "agent_end")] | last | (.messages // []) | map(select(.role == "assistant")) | last | (.content // []) | map(select(.type == "text") | .text) | join("\\n")')} ${q(join(run, "out.jsonl"))} > ${q(join(run, "out.log"))} 2>/dev/null; exit $RC`,
      ].join("\n");
    }
  }
}

function finalAnswer(p, run) {
  const read = (f) => { try { return readFileSync(join(run, f), "utf8"); } catch { return ""; } };
  if (p.harness === "codex") return read("final.txt").trim() || read("out.log").trim().slice(-4000);
  if (p.harness === "claude") return read("out.log").trim();
  if (p.harness === "agy") {
    const res = readJson(join(run, "agy", "result.json"));
    return res ? JSON.stringify(res, null, 2).slice(0, 6000) : read("out.log").trim().slice(-4000);
  }
  if (p.harness === "opencode") {
    // the answer is the text of the last step
    const events = read("out.jsonl").split("\n").map((l) => { try { return JSON.parse(l); } catch { return undefined; } }).filter(Boolean);
    const lastStart = events.map((e) => e.type).lastIndexOf("step_start");
    const text = events.slice(Math.max(0, lastStart)).filter((e) => e.type === "text").map((e) => e.part?.text ?? "").join("").trim();
    return text || read("err.log").trim().slice(-2000);
  }
  for (const line of read("out.jsonl").split("\n").reverse()) {
    try {
      const ev = JSON.parse(line);
      if (ev.type !== "agent_end") continue;
      const last = [...(ev.messages ?? [])].reverse().find((m) => m.role === "assistant");
      return (last?.content ?? []).filter((c) => c.type === "text").map((c) => c.text).join("\n").trim();
    } catch { /* not json */ }
  }
  return read("err.log").trim().slice(-2000);
}

// ── selection: concurrent, folded, cached ───────────────────────────────
const SELECT_FILE = join(CACHE, "select-cache.json");
const SELECT_TTL = 10 * 60_000, SELECT_MAX = 100;
const SELECT_KEY = createHash("sha1").update(`${opt.brief}\0${opt.cwd}`).digest("hex");
const selectDb = () => { const db = process.env.JDELEGATE_SELECT_CACHE === "0" ? undefined : readJson(SELECT_FILE); return db && typeof db === "object" && !Array.isArray(db) ? db : {}; };
const cachedEntry = (() => { const e = selectDb()[SELECT_KEY]; return e && Date.now() - e.t < SELECT_TTL ? e : undefined; })();
let cachedAny = false;
/** Merge freshly computed pieces into this brief's entry (the entry keeps its first write time), prune, cap at 100. */
function saveSelect(pieces) {
  if (process.env.JDELEGATE_SELECT_CACHE === "0" || !Object.keys(pieces).length) return;
  try {
    const now = Date.now(), db = selectDb();
    const live = Object.entries(db).filter(([, e]) => now - e.t < SELECT_TTL);
    const merged = Object.fromEntries(live);
    merged[SELECT_KEY] = { ...(merged[SELECT_KEY] ?? { t: now }), ...pieces };
    const kept = Object.entries(merged).sort((x, y) => y[1].t - x[1].t).slice(0, SELECT_MAX);
    mkdirSync(CACHE, { recursive: true });
    const tmpFile = `${SELECT_FILE}.${process.pid}.tmp`;
    writeFileSync(tmpFile, JSON.stringify(Object.fromEntries(kept)));
    renameSync(tmpFile, SELECT_FILE);
  } catch { /* the cache is an optimisation */ }
}
async function routeDecision() {
  const c = cachedEntry?.route;
  if (c) { cachedAny = true; return { ...c, ms: 0, failed: false, id: undefined }; }
  const decision = await timed("route", () => decide(opt.brief));
  if (!decision.failed) saveSelect({ route: { tier: decision.tier, kind: decision.kind, role: decision.role, conf: decision.conf, ui: decision.ui } });
  return decision;
}
/**
 * Skill, role and MCP selection for a harness. They do not depend on each other: skill is its own call, role and every MCP
 * server ride in ONE raw request, and both run at the same time. Every failure drops just that selection.
 * Resolves {skills, role, mcp}; mcp is undefined when MCP selection did not apply.
 */
async function selectWorker(harness) {
  const leanClaude = harness === "claude" && isLean();
  const base = harness !== "claude" || leanClaude;
  const wantSkill = base && !(explicitSkills.length || !opt.autoSkill);
  const wantRole = base && !explicitRole && opt.autoRole;
  const mcpOn = leanClaude && !opt.mcp.length && !opt.full && opt.autoMcp && Object.keys(autoMcpServers()).length > 0;
  const fresh = {};
  const hit = () => { cachedAny = true; };

  const skillTask = async () => {
    if (!wantSkill) return explicitSkills;
    if (typeof cachedEntry?.skill?.name === "string") { hit(); return skillFor(cachedEntry.skill.name); }
    const r = await timed("skill", () => suggestSkill(opt.brief));
    if (r.ok) fresh.skill = { name: r.name };
    return skillFor(r.name);
  };

  const rq = wantRole ? roleQuestion() : undefined;
  const roleSig = rq && JSON.stringify(rq.question);
  const mq = mcpOn ? mcpQuestions() : undefined;
  const mcpSig = mq && JSON.stringify(mq);
  const roleHit = rq && cachedEntry?.role?.sig === roleSig;
  const mcpHit = mq && cachedEntry?.mcp?.sig === mcpSig;
  const questions = { ...(rq && !roleHit ? { role: rq.question } : {}), ...(mq && !mcpHit ? mq : {}) };

  const jevTask = async () => {
    const answers = await timed("role+mcp", () => askFolded(opt.brief, questions));
    let role, mcp;
    if (rq) {
      if (roleHit) { hit(); role = cachedEntry.role.name ? roleOf(rq.found, cachedEntry.role.name) : undefined; }
      else {
        const parsed = answers ? parseRole(answers.role, rq.found) : undefined;
        role = parsed?.name ? roleOf(rq.found, parsed.name) : undefined;
        if (parsed) fresh.role = { sig: roleSig, name: parsed.name };
      }
    }
    if (mq) {
      if (mcpHit) { hit(); mcp = cachedEntry.mcp.names; }
      else {
        mcp = answers ? parseMcp(answers, mq) : [];
        if (answers) fresh.mcp = { sig: mcpSig, names: mcp };
      }
    }
    return { role, mcp };
  };

  const [skills, { role, mcp }] = await timed("selection", () => Promise.all([skillTask(), jevTask()]));
  saveSelect(fresh);
  return { skills, role, mcp };
}

// ── 4. run ──────────────────────────────────────────────────────────────
// With an explicit --harness the selections do not depend on the route: start them now, alongside it.
const earlySelection = opt.harness && !opt.print ? selectWorker(opt.harness) : undefined;
const d = await routeDecision();
// Owner rule 2026-10-03: a reviewer worker runs on the review chain (GPT first, Opus fallback), whatever kind the brief routed to.
if (opt.role === "reviewer" && CONFIG.kinds?.review) d.kind = "review";
if (CONFIG.kinds?.test && d.kind !== "review" && isTestWork(opt.brief, opt.role)) d.kind = "test";
const p = pick(d);
let head =
  `[jdelegate] ${d.tier} ${d.kind}·${d.role} (jev @${(d.conf ?? 0).toFixed(2)}, ui ${d.ui.toFixed(2)}, ${d.ms}ms` +
  `${d.failed ? `, jev failed: ${d.error} → safe default` : ""}) → ${p ? `${p.harness} · ${p.ref} · thinking ${p.thinking} (${p.why})` : "no live model"}`;
if (opt.print || !p) {
  console.log(head);
  process.exit(p ? 0 : 1);
}

if (p.harness === "claude" && !isLean() && (opt.role || opt.skills.length)) {
  console.error("jdelegate: --role/--skill are not applied with --full (the plain claude takes no worker prompt); drop --full or the flag");
  process.exit(2);
}
// Role and skill selection is harness-independent; only the claude harness also gets MCP selection.
const leanClaude = p.harness === "claude" && isLean();
if (p.harness !== "claude" || leanClaude) {
  const sel = await (earlySelection && p.harness === opt.harness ? earlySelection : selectWorker(p.harness));
  workerSkills = sel.skills;
  workerRole = explicitRole ?? sel.role;
  if (workerRole) head += ` · role: ${workerRole.name}${workerRole.auto ? " (auto)" : ""}`;
  if (leanClaude) {
    if (sel.mcp) {
      mcpNames = sel.mcp;
      if (mcpNames.length) head += ` · mcp: ${mcpNames.join(",")} (auto)`;
    }
    if (workerSkills.length) head += ` · skills: ${workerSkills.map((s) => s.name + (s.auto ? " (auto)" : "")).join(", ")}`;
  }
}
if (cachedAny) head += " · (cached)";

/** World live hook: `track add` in the background, 3 s cap, silent. WORLD_TRACK=0 disables; a missing track is a no-op. */
function worldTrack(args) {
  if (process.env.WORLD_TRACK === "0") return;
  try {
    const c = spawn("track", ["add", ...args, "--source", "live"], { stdio: "ignore", detached: true, timeout: 3000 });
    c.on("error", () => {});
    c.unref();
  } catch { /* the world feed never affects a worker */ }
}

function makeRun(attemptBrief, attemptP, attemptTier) {
  const run = join(CACHE, `${new Date().toISOString().replace(/[:.]/g, "-")}-${nameSlug}-${attemptTier}-${Math.random().toString(36).slice(2, 7)}`);
  mkdirSync(run, { recursive: true, mode: 0o700 });
  const briefFile = join(run, "brief.md");
  if (attemptP.harness === "claude") {
    writeFileSync(briefFile, attemptBrief);
    if (isLean()) {
      writeFileSync(join(run, "worker-prompt.md"), workerPrompt(workerSkills, workerRole));
      writeFileSync(join(run, "mcp.json"), leanMcpConfig(), { mode: 0o600 });
    }
  } else {
    // No system-prompt file on these harnesses: the worker prompt rides in front of the brief.
    writeFileSync(briefFile, `${workerPrompt(workerSkills, workerRole)}\n--- TASK ---\n${attemptBrief}`);
  }
  const label = `${nameLabel} · ${attemptP.ref.split("/").pop()}`;
  writeFileSync(join(run, "run.sh"),
    `#!/bin/bash\n# jdelegate worker: ${label.replace(/[\r\n]+/g, " ")}\nset -o pipefail\n` +
    `# record the bash pid so the wrapper can SIGTERM/SIGKILL the worker tree on timeout (closes the herdr tab is not enough: workers survive SIGHUP)\n` +
    `echo $$ > ${q(join(run, "pid"))}\n` +
    `# the worker records its own exit (also when killed), so a dead jdelegate wrapper loses nothing: see \`jdelegate wait\`\n` +
    `trap 'rc=$?; [ -e ${q(join(run, "exit"))} ] || { echo $rc > ${q(join(run, "exit.tmp"))}; mv ${q(join(run, "exit.tmp"))} ${q(join(run, "exit"))}; }' EXIT\n` +
    `cd ${q(opt.cwd)} || exit 1\nunset CLAUDE_ORCH\n` +
    `printf '\\e]2;%s\\a' ${q(label)}\necho ${q(`▶ ${label}  (${attemptTier} ${d.kind}·${d.role})`)}\n` +
    `( ${workerScript(attemptP, run, briefFile)} )\nRC=$?\necho $RC > ${q(join(run, "exit.tmp"))}; mv ${q(join(run, "exit.tmp"))} ${q(join(run, "exit"))}\n` +
    `echo; echo "■ done (exit $RC) — result: "${q(run)}\n`, { mode: 0o755 });
  return { run, label };
}

if (opt.dryRun) {
  const { run } = makeRun(opt.brief, p, d.tier);
  writeFileSync(join(run, "dry-run"), "");  // quota-snapshot does not count dry runs as provider calls
  let mcpShown = "";
  try {
    const cfg = JSON.parse(readFileSync(join(run, "mcp.json"), "utf8"));
    for (const def of Object.values(cfg.mcpServers ?? {}))
      for (const k of ["env", "headers"]) if (def && typeof def[k] === "object" && def[k]) def[k] = Object.fromEntries(Object.keys(def[k]).map((n) => [n, "***"]));
    mcpShown = `# mcp.json (secrets redacted): ${JSON.stringify(cfg)}\n`;
  } catch { /* no MCP config in this mode */ }
  console.log(`${head}\n[jdelegate] dry-run ${run}\n${mcpShown}${readFileSync(join(run, "run.sh"), "utf8")}`);
  process.exit(0);
}

/** Epoch ms when a codex "You've hit your usage limit" message says codex works again (absolute or relative form); 5 h from now when unparseable. */
function codexResetAt(text) {
  const abs = text.match(/try again at ([^\n]*?)\.?(?:\n|$)/i)?.[1]?.replace(/(\d)(st|nd|rd|th)\b/g, "$1");
  const t = abs ? Date.parse(abs) : NaN;
  if (t > Date.now()) return t;
  const rel = text.match(/try again in ((?:\d+\s*(?:days?|d|hours?|hrs?|h|minutes?|mins?|m)\s*,?\s*(?:and\s*)?)+)/i)?.[1];
  if (rel) {
    const unit = { d: 864e5, h: 36e5, m: 6e4 };
    let ms = 0;
    for (const [, n, u] of rel.matchAll(/(\d+)\s*(days?|d|hours?|hrs?|h|minutes?|mins?|m)/gi)) ms += Number(n) * unit[u[0].toLowerCase()];
    if (ms) return Date.now() + ms;
  }
  return Date.now() + 5 * 36e5;
}
/** A codex worker that hit the plan limit: record the provider as exhausted so every router skips it. Returns true when it did. */
function markCodexExhausted(attemptP, run) {
  if (attemptP.harness !== "codex") return false;
  let text = "";
  try { text = readFileSync(join(run, "out.log"), "utf8"); } catch { return false; }
  if (!/You've hit your usage limit/i.test(text)) return false;
  const until = codexResetAt(text);
  EXHAUSTED["openai-codex"] = until;
  try {
    const cur = readJson(EXHAUSTED_FILE) ?? {};
    mkdirSync(dirname(EXHAUSTED_FILE), { recursive: true });
    writeFileSync(EXHAUSTED_FILE, JSON.stringify({ ...cur, "openai-codex": until }, null, 2));
  } catch { /* the in-memory mark still drives this run's fallback */ }
  return true;
}

async function execute(attemptBrief, attemptP, attemptTier) {
  const { run, label } = makeRun(attemptBrief, attemptP, attemptTier);
  const started = Date.now();
  const ref = basename(run), model = attemptP.ref.split("/").pop(), project = basename(opt.cwd).toLowerCase();
  const worldEvent = (status, extra = []) => worldTrack(["--kind", "worker", "--project", project, "--status", status, "--title", label, "--ref", ref, "--model", model, ...extra, "--key", `run:${ref}:${status}`]);
  worldEvent("running");
  const inHerdr = opt.tab && process.env.HERDR_ENV === "1" && process.env.HERDR_PANE_ID;
  let where = "inline";
  if (inHerdr) {
    const herdr = (args) => spawnSync("herdr", args, { encoding: "utf8", timeout: 8000 }).stdout ?? "";
    const field = (s, k) => s.match(new RegExp(`"${k}"\\s*:\\s*"([^"]+)"`))?.[1];
    const ws = field(herdr(["pane", "get", process.env.HERDR_PANE_ID]), "workspace_id");
    const out = herdr(["tab", "create", "--no-focus", "--label", label, "--cwd", opt.cwd, ...(ws ? ["--workspace", ws] : [])]);
    const pane = field(out, "pane_id"), tab = field(out, "tab_id");
    if (tab) writeFileSync(join(run, "tab"), tab);
    if (pane) {
      herdr(["pane", "run", pane, `bash ${q(join(run, "run.sh"))}`]);
      where = `herdr tab "${label}"`;
    }
  }
  // Inline mode: launch with `detached: true` so the run.sh is its own session/process-group leader. The child pid is also
  // the pgid, which lets a timeout kill the whole tree (bash + worker + worker children) in one shot via `kill -TERM -<pid>`.
  // The old spawnSync + timeout only killed bash; the worker kept running and was orphaned.
  let inlinePid;
  if (where === "inline") {
    const child = spawn("bash", [join(run, "run.sh")], { stdio: "ignore", detached: true });
    inlinePid = child.pid;
  }
  // The timeout we enforce here, in ms. JDELEGATE_TIMEOUT_MS overrides --timeout for tests.
  const limitMs = timeoutMs();
  while (!existsSync(join(run, "exit"))) {
    if (Date.now() - started > limitMs) {
      await killWorkerTree({ run, inlinePid, where, tab: existsSync(join(run, "tab")) ? readFileSync(join(run, "tab"), "utf8").trim() : "" });
      // The user-facing value, in minutes. Use the original --timeout number (so the message matches what was passed
      // on the command line, even when JDELEGATE_TIMEOUT_MS overrides the wall-clock value for tests).
      worldEvent("failed", ["--dur", String(Math.round((Date.now() - started) / 1000))]);
      const minutesText = `${opt.timeout} min`;
      console.log(`${head}\n[jdelegate] timed out after ${minutesText} in ${where}; worker tree killed, result will be in ${run}`);
      process.exit(124);
    }
    await new Promise((r) => setTimeout(r, 500));
  }
  const rc = Number(readFileSync(join(run, "exit"), "utf8").trim()) || 0;
  worldEvent(rc === 0 ? "done" : "failed", ["--dur", String(Math.round((Date.now() - started) / 1000))]);
  const answer = finalAnswer(attemptP, run);
  const tabFile = join(run, "tab");
  if (!opt.keepTab && existsSync(tabFile)) {
    try {
      const tab = readFileSync(tabFile, "utf8").trim();
      if (tab && spawnSync("herdr", ["tab", "close", tab], { encoding: "utf8", timeout: 8000 }).status === 0) unlinkSync(tabFile);
    } catch { /* a tab that will not close must not fail the job */ }
  }
  return { run, where, started, rc, answer };
}

/**
 * Kill the whole worker tree on timeout and close the herdr tab. Inline: the detached child is its own session/pgrp
 * leader, so its pid is the pgid; `kill -TERM -<pid>` reaches bash + worker + worker children. Herdr tab mode: the
 * worker runs locally (herdr is a local terminal multiplexer), so the run.sh writes its bash pid to `<run>/pid`; we
 * collect the full descendant tree with recursive `pgrep -P` BEFORE killing, then SIGTERM them all, wait up to 5 s for
 * the EXIT trap to write the exit file, then SIGKILL survivors. Closing the tab alone is not enough (workers survive
 * SIGHUP). After the kill, we close the tab as before.
 */
async function killWorkerTree({ run, inlinePid, where, tab }) {
  if (where === "inline" && inlinePid) {
    try { process.kill(-inlinePid, "SIGTERM"); } catch { /* already gone */ }
    // Give bash 5 s to run its EXIT trap and write the exit file; then SIGKILL anything left.
    for (let i = 0; i < 50 && !existsSync(join(run, "exit")); i++) await new Promise((r) => setTimeout(r, 100));
    try { process.kill(-inlinePid, "SIGKILL"); } catch { /* already gone */ }
    // If anything still lives (it shouldn't), recurse on children of the inline pid.
    for (let i = 0; i < 3; i++) {
      const left = spawnSync("pgrep", ["-P", String(inlinePid)], { encoding: "utf8" }).stdout.trim();
      if (!left) break;
      for (const p of left.split("\n")) { try { process.kill(Number(p), "SIGKILL"); } catch {} }
    }
  } else {
    // herdr tab (or any other mode): bash wrote its pid to <run>/pid on startup; collect the full descendant tree
    // BEFORE killing, then SIGTERM all of them, wait for the EXIT trap, SIGKILL survivors.
    const pidFile = join(run, "pid");
    let rootPid;
    try { rootPid = Number(readFileSync(pidFile, "utf8").trim()); } catch { rootPid = NaN; }
    if (Number.isFinite(rootPid) && rootPid > 0) {
      const collect = (pid) => {
        const kids = spawnSync("pgrep", ["-P", String(pid)], { encoding: "utf8" }).stdout.trim().split("\n").filter(Boolean).map(Number).filter(Number.isFinite);
        const out = [pid];
        for (const k of kids) out.push(...collect(k));
        return out;
      };
      const tree = collect(rootPid);
      for (const p of tree) { try { process.kill(p, "SIGTERM"); } catch {} }
      // Give bash 5 s to run its EXIT trap and write the exit file; then SIGKILL anything left.
      for (let i = 0; i < 50 && !existsSync(join(run, "exit")); i++) await new Promise((r) => setTimeout(r, 100));
      for (const p of tree) { try { process.kill(p, "SIGKILL"); } catch {} }
    }
  }
  if (tab) {
    try { spawnSync("herdr", ["tab", "close", tab], { encoding: "utf8", timeout: 8000 }); } catch { /* the tab may be already gone */ }
  }
}

const initialTier = d.tier;
let tier = initialTier, currentP = p, brief = opt.brief;
let result = await execute(brief, currentP, tier);
if (markCodexExhausted(currentP, result.run)) {
  const next = pick({ ...d, tier });
  if (next) { currentP = next; result = await execute(brief, currentP, tier); }
}
// agy out of quota: record it and retry once on the claude chain at the same tier (never escalate to agy T4 for this).
if (markAgyExhausted(currentP, result.run)) {
  const next = pick({ ...d, tier }, { noAgy: true });
  if (next) { currentP = next; result = await execute(brief, currentP, tier); }
}
let escalationReason = "";
let verdict;
if (result.rc !== 0) verdict = { choice: "failed_needs_stronger", confidence: 1 };
else {
  try {
    const judged = spawnSync(JEV, ["raw", "--log", "router-delegate-output"], {
      input: JSON.stringify(buildOutputBody({ goal: brief, tier, final_text: result.answer.slice(0, 4000), tool_errors: 0, turns: 1 })),
      encoding: "utf8", timeout: 8000,
    });
    verdict = JSON.parse(judged.stdout).answers.outcome;
  } catch { verdict = undefined; }
}
if (!opt.noEscalate && TIERS.indexOf(tier) < 4 && verdict?.choice === "failed_needs_stronger" && Number(verdict.confidence) >= 0.6) {
  const previousAnswer = result.answer.slice(0, 2000);
  const oldTier = tier;
  tier = TIERS[TIERS.indexOf(tier) + 1];
  currentP = pick({ ...d, tier });
  escalationReason = result.rc !== 0 ? `worker exited ${result.rc}` : `jev confidence ${Number(verdict.confidence).toFixed(2)}`;
  if (currentP) {
    brief = `${opt.brief}\n\nA previous attempt on a weaker model did not finish the job. Its final report:\n${previousAnswer}\nFinish the job.`;
    result = await execute(brief, currentP, tier);
  } else {
    tier = oldTier;
    currentP = p;
    escalationReason = "no live model at next tier";
  }
}
if (d.id) spawnSync(JEV, ["outcome", d.id, tier], { encoding: "utf8", timeout: 8000 });
console.log(`${head}\n${escalationReason ? `[jdelegate] escalated ${initialTier} → ${tier}: ${escalationReason}\n` : ""}[jdelegate] ${result.where} · ${Math.round((Date.now() - result.started) / 1000)}s · exit ${result.rc} · ${result.run}\n--- result ---\n${result.answer}`);
process.exit(result.rc);
