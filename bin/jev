#!/usr/bin/env python3
"""jev — typed decisions from TypeSafe Jev (via OpenRouter) for shells, hooks, skills and agents.

Jev is a decisions model, not a chat model: it answers a question about some state with a
label, a probability or a score, plus a calibrated confidence. ~0.5-1 s, ~$0.00002 per call.
It never writes text, never sees images/audio, and state is capped at 32k tokens.

Usage:
  jev choice "<question>" opt="description" opt2="description" ... [state options]
  jev noul   "<yes/no statement>"                                 [state options]
  jev score  "<question>" "level 0" "level 1" "level 2" ...       [state options]
  jev route  "<task description>"     which model tier should do this task (T0-T4)
  jev raw    < request.json           full {"state":…,"questions":{…}} body, prints the response

System 2 retraining System 1 (see skills/jev/SKILL.md, "System 1 and System 2"):
  --log TAG            on any command: append each decision to the decision log under TAG
                       (the decision id goes to stderr as `jev-id: <id>`)
  jev outcome ID VALUE record what the answer should have been (choice name, yes/no, score level)
  jev tune TAG [--n N] disagreements and least-confident decisions for TAG, as JSON, for an LLM
                       to revise the criteria, options and thresholds
  Log: $JEV_LOG_DIR/decisions.jsonl (default ~/.local/state/jev/).

State options (the thing being judged):
  -s, --state TEXT     text, or a JSON object/array (parsed if it is valid JSON)
  -f, --state-file P   read state from a file
  (stdin)              used when neither is given and stdin is not a terminal

Output and exit codes:
  default     JSON: {"choice":…,"confidence":…} / {"noul":…} / {"score":…,"confidence":…}
  -q          only the answer: the choice, the probability, or the score
  --min C     choice/score: exit 2 when confidence < C (so `jev … --min 0.8 || fallback`)
  --yes T     noul: exit 0 when probability >= T, else 1 (so `if jev noul … --yes 0.7`)
  exit 3      API / key / network error (message on stderr)

Key: $OPENROUTER_API_KEY, else the openrouter key in ~/.local/share/opencode/auth.json.
Model: $JEV_MODEL (default typesafe/jev-1.13). Endpoint: $JEV_DECISIONS_URL.

Also importable (the other jev-* tools load it): post(), ask(), ask_many(), log_decision(), JevError.
"""
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request

URL = os.environ.get("JEV_DECISIONS_URL", "https://openrouter.ai/api/alpha/decisions")
MODEL = os.environ.get("JEV_MODEL", "typesafe/jev-1.13")
PRICE_PER_INPUT_TOKEN = 0.042 / 1_000_000

ROUTE_TIERS = {
    "T0": "A label, yes/no, score or routing decision. No text needs to be written.",
    "T1": "Internal summary, digest, extraction or rewrite that only the owner reads; public or non-sensitive input.",
    "T2": "Text a client, recruiter or the public reads (replies, proposals, posts, captions), or describing an image.",
    "T3": "Coding, debugging, refactoring, multi-file changes, a deploy, or planning a feature.",
    "T4": "Hardest long-horizon work: architecture across systems, security-critical review, or driving a GUI.",
}
ROUTE_MODELS = {
    "T0": "jev (typesafe/jev-1.13)",
    "T1": "free: openrouter deepseek/deepseek-v4-flash-0731:free (public input only)",
    "T2": "claude-sonnet-5 (haiku-4-5 for short chat)",
    "T3": "claude-opus-5",
    "T4": "claude-fable-5-1, or gpt-6-astra for computer use",
}


class JevError(Exception):
    """No key, HTTP error, network failure, or a malformed response. Callers fall back."""


def die(msg, code=3):
    print(f"jev: {msg}", file=sys.stderr)
    sys.exit(code)


def api_key():
    key = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if key:
        return key
    try:
        with open(os.path.expanduser("~/.local/share/opencode/auth.json")) as f:
            key = (json.load(f).get("openrouter") or {}).get("key", "")
    except (OSError, ValueError):
        key = ""
    if not key:
        raise JevError("no key: set OPENROUTER_API_KEY or add an openrouter key to opencode auth.json")
    return key


def post(body, timeout=None):
    req = urllib.request.Request(
        URL,
        data=json.dumps(body).encode(),
        headers={
            "Authorization": f"Bearer {api_key()}",
            "Content-Type": "application/json",
            # urllib's default User-Agent gets Cloudflare error 1010 on some gateways.
            "User-Agent": "dev-stack-jev/1.0",
            "X-Title": "dev-stack jev",
        },
        method="POST",
    )
    if timeout is None:
        timeout = float(os.environ.get("JEV_TIMEOUT", "20"))
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        raise JevError(f"HTTP {e.code}: {e.read().decode()[:300]}") from e
    except (OSError, ValueError) as e:
        raise JevError(f"request failed: {e}") from e


# --- decision log (System 2 retrains System 1) -------------------------------------------

def log_path():
    d = os.environ.get("JEV_LOG_DIR") or os.path.expanduser("~/.local/state/jev")
    return os.path.join(d, "decisions.jsonl")


def _append(rec):
    p = log_path()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")


def _value(answer):
    kind = answer.get("type")
    return kind, answer.get(kind) if kind in ("choice", "noul", "score") else None


def log_decision(tag, state, question, answer):
    """Append one decision; returns its id. State is kept as a 600-char preview plus a hash."""
    s = state if isinstance(state, str) else json.dumps(state, ensure_ascii=False, sort_keys=True)
    kind, value = _value(answer)
    did = hashlib.sha1(f"{time.time_ns()}{tag}{s}{json.dumps(question, sort_keys=True)}".encode()).hexdigest()[:12]
    _append({
        "kind_of_record": "decision", "id": did, "ts": int(time.time()), "tag": tag,
        "state_hash": hashlib.sha1(s.encode()).hexdigest()[:12], "state_len": len(s),
        # Defence in depth: callers importing log_decision may pass an unredacted state.
        "state_preview": redact(s)[:600] if os.environ.get("JEV_LOG_PREVIEW") == "1" else None,
        "question": question, "kind": kind, "value": value, "confidence": answer.get("confidence"),
    })
    return did


def log_outcome(did, outcome):
    _append({"kind_of_record": "outcome", "id": did, "ts": int(time.time()), "outcome": str(outcome)})


def uncertainty(rec):
    """0 = certain, 1 = coin flip / unknown."""
    if rec.get("kind") == "noul":
        p = rec.get("value")
        return 1.0 if p is None else 1.0 - 2.0 * abs(p - 0.5)
    c = rec.get("confidence")
    return 1.0 if c is None else 1.0 - c


def disagrees(rec, outcome):
    kind, value = rec.get("kind"), rec.get("value")
    if kind == "noul":
        want = str(outcome).lower() in ("yes", "true", "1")
        return ((value or 0) >= 0.5) != want
    if kind == "score":
        try:
            return round(value or 0) != round(float(outcome))
        except ValueError:
            return True
    return str(value) != str(outcome)


def tune_report(tag, n=20):
    decisions, outcomes = {}, {}
    try:
        with open(log_path()) as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if r.get("kind_of_record") == "outcome":
                    outcomes[r["id"]] = r["outcome"]
                elif r.get("tag") == tag:
                    decisions[r["id"]] = r
    except OSError:
        pass
    rows = []
    for did, r in decisions.items():
        row = {k: r.get(k) for k in ("id", "ts", "kind", "value", "confidence", "state_preview", "question")}
        row["uncertainty"] = round(uncertainty(r), 3)
        if did in outcomes:
            row["outcome"] = outcomes[did]
            row["disagrees"] = disagrees(r, outcomes[did])
        rows.append(row)
    dis = [r for r in rows if r.get("disagrees")]
    unc = sorted((r for r in rows if not r.get("disagrees")), key=lambda r: -r["uncertainty"])
    return {
        "tag": tag, "decisions": len(rows), "with_outcome": sum(1 for r in rows if "outcome" in r),
        "disagreements": dis[:n], "uncertain": unc[:n],
        "how_to_use": "Revise the criteria/options/instructions/thresholds for this tag so the disagreements "
                      "would be answered right, then re-run the uncertain states to check.",
    }


# --- asking --------------------------------------------------------------------------------

def parse_state(text):
    try:
        v = json.loads(text)
        return v if isinstance(v, (dict, list)) else text
    except ValueError:
        return text


SECRET_RE = re.compile(
    r"sk-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}"
    r"|(?i:(?:api[_-]?key|secret|token|passw(?:or)?d)(?:\\?[\"']?\s*[:=]\s*\\?[\"']))[^\"'\\\s]{6,}")


def redact(state):
    """Mask key- and secret-shaped strings before the state leaves the machine."""
    return json.loads(SECRET_RE.sub("[REDACTED]", json.dumps(state, ensure_ascii=False)))


def ask_many(state, questions, tag=None, timeout=None):
    """Several questions over one state in one request. Returns (answers, ids, cost)."""
    state = redact(state)  # the same redacted state is sent AND logged
    res = post({"model": MODEL, "state": state, "questions": questions}, timeout)
    answers = res.get("answers") or {}
    if not all(k in answers for k in questions):
        raise JevError(f"unexpected response: {json.dumps(res)[:300]}")
    ids = {k: log_decision(tag, state, questions[k], answers[k]) for k in questions} if tag else {}
    return answers, ids, (res.get("usage") or {}).get("cost")


def ask(state, question, tag=None, timeout=None):
    answers, ids, _ = ask_many(state, {"q": question}, tag, timeout)
    if ids:
        print(f"jev-id: {ids['q']}", file=sys.stderr)
    return answers["q"]


def take_opts(args):
    """Split flags from positionals. Returns (positionals, opts)."""
    opts = {"quiet": False, "min": None, "yes": None, "state": None, "log": None, "n": 20}
    pos, i = [], 0
    while i < len(args):
        a = args[i]
        if a in ("-q", "--quiet"):
            opts["quiet"] = True
        elif a in ("-s", "--state", "-f", "--state-file", "--min", "--yes", "--log", "--n"):
            if i + 1 >= len(args):
                die(f"{a} needs a value", 64)
            v = args[i + 1]
            i += 1
            if a in ("-s", "--state"):
                opts["state"] = parse_state(v)
            elif a in ("-f", "--state-file"):
                try:
                    with open(v) as fh:
                        opts["state"] = parse_state(fh.read())
                except OSError as e:
                    die(f"cannot read {v}: {e}", 64)
            elif a == "--log":
                opts["log"] = v
            elif a == "--n":
                opts["n"] = int(v)
            else:
                opts[a[2:]] = float(v)
        else:
            pos.append(a)
        i += 1
    return pos, opts


def cli_ask(opts, question):
    state = opts["state"]
    # stdin only when nothing else supplied the state, so `jev route "task"` never blocks on it.
    if state is None and not sys.stdin.isatty():
        state = parse_state(sys.stdin.read())
    if state is None or state == "":
        die("no state: pass --state, --state-file, or pipe it on stdin", 64)
    return ask(state, question, opts["log"])


def emit_choice_or_score(a, key, opts, extra=None):
    conf = a.get("confidence")
    out = {key: a.get(key), "confidence": conf}
    if extra:
        out.update(extra)
    print(a.get(key) if opts["quiet"] else json.dumps(out, ensure_ascii=False))
    if opts["min"] is not None and (conf is None or conf < opts["min"]):
        sys.exit(2)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    pos, opts = take_opts(rest)

    if cmd == "raw":
        body = json.load(sys.stdin)
        body.setdefault("model", MODEL)
        if "state" in body:
            body["state"] = redact(body["state"])
        res = post(body)
        if opts["log"]:
            for k, a in (res.get("answers") or {}).items():
                q = (body.get("questions") or {}).get(k)
                if q:
                    print(f"jev-id: {k} {log_decision(opts['log'], body.get('state'), q, a)}", file=sys.stderr)
        print(json.dumps(res, ensure_ascii=False))
    elif cmd == "choice":
        if len(pos) < 3:
            die('usage: jev choice "<question>" a="…" b="…" [--state …]', 64)
        criteria = {}
        for p in pos[1:]:
            name, _, desc = p.partition("=")
            criteria[name] = desc or None
        a = cli_ask(opts, {"type": "choice", "instructions": pos[0], "criteria": criteria})
        emit_choice_or_score(a, "choice", opts)
    elif cmd == "noul":
        if len(pos) != 1:
            die('usage: jev noul "<statement>" [--state …] [--yes 0.7]', 64)
        a = cli_ask(opts, {"type": "noul", "instructions": pos[0]})
        p = a.get("noul")
        print(p if opts["quiet"] else json.dumps({"noul": p}))
        if opts["yes"] is not None:
            sys.exit(0 if (p or 0) >= opts["yes"] else 1)
    elif cmd == "score":
        if len(pos) < 3:
            die('usage: jev score "<question>" "level 0" "level 1" … [--state …]', 64)
        a = cli_ask(opts, {"type": "score", "instructions": pos[0], "criteria": pos[1:]})
        emit_choice_or_score(a, "score", opts)
    elif cmd == "route":
        if pos:
            opts["state"] = " ".join(pos)
        a = cli_ask(opts, {
            "type": "choice",
            "instructions": "Which model tier should do this task. Pick the cheapest tier that can do it well.",
            "criteria": ROUTE_TIERS,
        })
        emit_choice_or_score(a, "choice", opts, {"model": ROUTE_MODELS.get(a.get("choice"))})
    elif cmd == "outcome":
        if len(pos) != 2:
            die("usage: jev outcome <id> <value>", 64)
        log_outcome(pos[0], pos[1])
    elif cmd == "tune":
        if len(pos) != 1:
            die("usage: jev tune <tag> [--n 20]", 64)
        print(json.dumps(tune_report(pos[0], opts["n"]), ensure_ascii=False, indent=1))
    else:
        die(f"unknown command {cmd!r}; see jev --help", 64)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except JevError as e:
        die(str(e))
