#!/usr/bin/env bash
# jev-chrome — start (or report) the ONE Chrome that jev-browse and chrome-devtools-mcp both drive.
#
# Both speak CDP, so they can share a browser: Jev runs the repeatable flows in it, and Claude attaches to
# the same tabs through chrome-devtools-mcp to look at console, network and performance when a flow goes red.
# One browser, one profile, one set of logins.
#
#   jev-chrome            start it (visible) if it is not already up, print the CDP url
#   jev-chrome --status   say whether it is up, exit 1 if not
#   jev-chrome --stop     quit it
#
#   jev-browse --cdp http://127.0.0.1:9333 --flows e2e/flows.json     # Jev drives it
#   chrome-devtools-mcp --browserUrl http://127.0.0.1:9333            # Claude inspects it (via MCP config)
#
# Port 9333, not 9222: 9222 is where Lightpanda listens, and pointing these at the wrong browser is a
# confusing failure. Profile lives in ~/.cache/jev-browse/profiles/shared — sign in there once with
# `jev-browse --login --profile shared --url <login page>` and every run is authenticated.
set -euo pipefail
PORT="${JEV_CHROME_PORT:-9333}"
PROFILE="${JEV_CHROME_PROFILE:-$HOME/.cache/jev-browse/profiles/shared}"
URL="http://127.0.0.1:$PORT"

up() { curl -s -m 2 "$URL/json/version" >/dev/null 2>&1; }

case "${1:-start}" in
  --status)
    if up; then echo "jev-chrome: up at $URL"; else echo "jev-chrome: not running"; exit 1; fi ;;
  --stop)
    pkill -f "remote-debugging-port=$PORT" 2>/dev/null && echo "jev-chrome: stopped" || echo "jev-chrome: was not running" ;;
  start|"")
    if up; then echo "$URL"; exit 0; fi
    CHROME="${JEV_BROWSER:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
    [ -x "$CHROME" ] || CHROME="$(command -v google-chrome || command -v chromium || true)"
    [ -n "$CHROME" ] && [ -x "$CHROME" ] || { echo "jev-chrome: no Chrome found; set JEV_BROWSER" >&2; exit 3; }
    mkdir -p "$PROFILE"
    nohup "$CHROME" --remote-debugging-port="$PORT" --user-data-dir="$PROFILE" \
      --no-first-run --no-default-browser-check about:blank >/tmp/jev-chrome.log 2>&1 &
    for _ in $(seq 1 30); do up && { echo "$URL"; exit 0; }; sleep 0.3; done
    echo "jev-chrome: Chrome did not open a debugging port (see /tmp/jev-chrome.log)" >&2; exit 3 ;;
  *) echo "usage: jev-chrome [--status|--stop]" >&2; exit 64 ;;
esac
