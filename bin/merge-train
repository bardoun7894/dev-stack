#!/usr/bin/env bash
# merge-train: land several reviewed PRs in one CI run (a train-* branch, P1 tier on boat).
#   merge-train build <owner/repo> <train-branch> <pr> [<pr>...]   build, push and open the train PR
#   merge-train land  <owner/repo> <train-pr>                       merge a green train, then report each PR
# Each PR is merged at the head SHA seen at build time and set to draft, so a review bot or agent stops pushing
# to it while the train runs (pushes after build are not in the train). land merges with --match-head-commit and
# lists every PR that did not land (its head moved), so it goes into the next train instead of being lost.
set -euo pipefail

die() { echo "merge-train: $*" >&2; exit 2; }
[ $# -ge 3 ] || die "usage: merge-train build <owner/repo> <train-branch> <pr>... | land <owner/repo> <train-pr>"
cmd=$1 repo=$2
shift 2

case "$cmd" in
build)
  branch=$1; shift
  case "$branch" in train-*) ;; *) die "train branch must start with train- (that is what makes it P1)";; esac
  cache=${MERGE_TRAIN_CACHE:-$HOME/.cache/merge-train}/${repo//\//_}
  if [ ! -d "$cache/.git" ]; then
    git clone -q --filter=blob:none --no-checkout "https://github.com/$repo.git" "$cache"
  fi
  cd "$cache"
  refspecs=(+refs/heads/main:refs/remotes/origin/main)
  for n in "$@"; do refspecs+=("+refs/pull/$n/head:refs/remotes/pr/$n"); done
  git fetch -q origin "${refspecs[@]}"
  git checkout -q -B "$branch" origin/main
  command -v branch-lock >/dev/null && branch-lock claim "$branch" --note "merge train" >/dev/null || true
  body="Merge train (train-* = P1). PRs at the head SHA they had when the train was built (each set to draft):"$'\n'
  landed=()
  for n in "$@"; do
    sha=$(git rev-parse "pr/$n")
    if git -c core.hooksPath=/dev/null merge -q --no-ff -m "Merge PR #$n (${sha:0:9}) into $branch" "pr/$n" >/dev/null 2>&1; then
      landed+=("$n"); body+="- #$n@$sha"$'\n'
    else
      git merge --abort 2>/dev/null || true
      echo "SKIP #$n: conflicts with main or an earlier PR in this train"
    fi
  done
  [ ${#landed[@]} -gt 0 ] || die "no PR merged cleanly; nothing pushed"
  for n in "${landed[@]}"; do
    [ "$(gh pr view "$n" -R "$repo" --json isDraft --jq .isDraft)" = true ] || gh pr ready "$n" -R "$repo" --undo >/dev/null
  done
  git push -q -f origin "$branch"
  url=$(gh pr create -R "$repo" --base main --head "$branch" --title "$branch: #${landed[*]// /, #}" --body "$body")
  echo "train $branch: ${landed[*]} -> $url"
  ;;
land)
  pr=$1
  read -r head state < <(gh pr view "$pr" -R "$repo" --json headRefOid,state --jq '"\(.headRefOid) \(.state)"')
  [ "$state" = OPEN ] || die "train PR #$pr is $state"
  ok=$(gh pr view "$pr" -R "$repo" --json statusCheckRollup --jq '[.statusCheckRollup[]|select(.name=="ci-ok")][0].conclusion // "none"')
  [ "$ok" = SUCCESS ] || die "train PR #$pr ci-ok is $ok; not merging"
  gh pr merge "$pr" -R "$repo" --merge --match-head-commit "$head" >/dev/null
  sleep 3
  fail=0
  while read -r n sha; do
    now=$(gh pr view "$n" -R "$repo" --json state,headRefOid --jq '"\(.state) \(.headRefOid)"')
    case "$now" in
      MERGED*) echo "#$n landed (${sha:0:9})" ;;
      *) echo "#$n NOT landed: train had ${sha:0:9}, PR is now ${now}. Put it in the next train."; fail=1 ;;
    esac
  done < <(gh pr view "$pr" -R "$repo" --json body --jq '.body' | sed -n 's/^- #\([0-9]*\)@\([0-9a-f]*\)$/\1 \2/p')
  exit $fail
  ;;
*) die "unknown command $cmd" ;;
esac
