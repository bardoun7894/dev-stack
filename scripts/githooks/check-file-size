#!/usr/bin/env bash
# check-file-size — block commits that stage files over a token budget.
# Tokens are estimated as bytes / 4. Default limit: 5,000 tokens (20,000 bytes).
#
# Only staged (added/copied/modified/renamed) files are checked, using the
# STAGED content. A file already over the limit in HEAD is not blocked for a
# small edit: only new files over the limit, files that cross the limit in this
# commit, and files over the limit that grow by more than 10% are blocked. Skips files agents don't author: lockfiles, minified or
# generated code, build output, vendored deps, binaries, and anything marked
# linguist-generated / -diff in .gitattributes.
#
# Tune per repo:
#   git config hooks.maxFileTokens 8000         raise or lower the limit
#   .tokenignore in the repo root               one glob per line to skip (e.g. docs/legacy/*)
# Bypass once:
#   SKIP_TOKEN_CHECK=1 git commit ...

set -uo pipefail
[ "${SKIP_TOKEN_CHECK:-0}" = "1" ] && exit 0

GIT_DIR_PATH=$(git rev-parse --git-dir 2>/dev/null) || exit 0
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Merges, rebases, cherry-picks and reverts replay existing work, not new authoring.
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    [ -e "$GIT_DIR_PATH/$marker" ] && exit 0
done
[ -d "$GIT_DIR_PATH/rebase-merge" ] && exit 0
[ -d "$GIT_DIR_PATH/rebase-apply" ] && exit 0

MAX_TOKENS=$(git config --get hooks.maxFileTokens 2>/dev/null || true)
case "$MAX_TOKENS" in ''|*[!0-9]*) MAX_TOKENS=5000 ;; esac
MAX_BYTES=$((MAX_TOKENS * 4))

is_ignored() {
    local f="$1" base="${1##*/}"
    case "$base" in
        package-lock.json|npm-shrinkwrap.json|yarn.lock|pnpm-lock.yaml|bun.lock|bun.lockb|\
        composer.lock|Gemfile.lock|Cargo.lock|poetry.lock|Pipfile.lock|uv.lock|pdm.lock|\
        Podfile.lock|pubspec.lock|go.sum|mix.lock|flake.lock|packages.lock.json|*.lock) return 0 ;;
        *.min.js|*.min.css|*.min.mjs|*.map|*.snap|*.svg|*.lottie|*.csv|*.tsv|*.ndjson|*.jsonl|\
        *.g.dart|*.freezed.dart|*.gr.dart|*.mocks.dart|*.config.dart|*.pb.go|*_pb2.py|*_pb2_grpc.py|*.pb.ts|\
        *.generated.*|*.gen.*|*.d.ts|*.pbxproj|*.xcstrings|*.storyboard|*.xib|*.ipynb|*.sql.gz|*.patch|*.diff) return 0 ;;
    esac
    case "/$f" in
        */node_modules/*|*/vendor/*|*/dist/*|*/build/*|*/.next/*|*/.nuxt/*|*/out/*|*/coverage/*|\
        */generated/*|*/__generated__/*|*/gen/*|*/.dart_tool/*|*/Pods/*|*/public/build/*|\
        */storage/*|*/bootstrap/cache/*|*/__snapshots__/*|*/fixtures/*|*/migrations/*schema*) return 0 ;;
    esac
    # .gitattributes: linguist-generated, linguist-vendored, or -diff
    local attrs
    attrs=$(git check-attr linguist-generated linguist-vendored diff -- "$f" 2>/dev/null)
    case "$attrs" in
        *"linguist-generated: true"*|*"linguist-generated: set"*|\
        *"linguist-vendored: true"*|*"linguist-vendored: set"*|*"diff: unset"*) return 0 ;;
    esac
    # Repo-specific .tokenignore globs
    if [ -f "$REPO_ROOT/.tokenignore" ]; then
        local pat
        while IFS= read -r pat || [ -n "$pat" ]; do
            pat="${pat%%#*}"; pat="${pat%"${pat##*[![:space:]]}"}"
            [ -z "$pat" ] && continue
            # shellcheck disable=SC2053
            [[ "$f" == $pat ]] && return 0
        done < "$REPO_ROOT/.tokenignore"
    fi
    return 1
}

# Binary files show "-" in numstat; collect them so we can skip them.
BINARIES=$(git diff --cached --numstat --diff-filter=ACMR 2>/dev/null | awk -F'\t' '$1=="-" {print $3}')

OFFENDERS=""
COUNT=0
# -z name-status: "M\0path\0", "R100\0old\0new\0"; for a rename or copy the old path is the baseline.
while IFS= read -r -d '' st; do
    IFS= read -r -d '' p1 || break
    old="$p1"; f="$p1"
    case "$st" in R*|C*) IFS= read -r -d '' f || break ;; esac
    is_ignored "$f" && continue
    if [ -n "$BINARIES" ] && printf '%s\n' "$BINARIES" | grep -qxF -- "$f"; then continue; fi
    bytes=$(git cat-file -s ":$f" 2>/dev/null) || continue
    [ "$bytes" -gt "$MAX_BYTES" ] || continue
    case "$st" in A*) old_bytes="" ;; *) old_bytes=$(git cat-file -s "HEAD:$old" 2>/dev/null || true) ;; esac
    # Already over the limit before this commit and grown by at most 10%: let it through.
    if [ -n "$old_bytes" ] && [ "$old_bytes" -gt "$MAX_BYTES" ] && [ $((bytes * 100)) -le $((old_bytes * 110)) ]; then continue; fi
    tokens=$((bytes / 4))
    OFFENDERS="${OFFENDERS}    ${f}  (~${tokens} tokens, ${bytes} bytes)\n"
    COUNT=$((COUNT + 1))
done < <(git diff --cached --name-status -M --diff-filter=ACMR -z 2>/dev/null)

[ "$COUNT" -eq 0 ] && exit 0

{
printf '\n'
printf '╭─────────────────────────────────────────────────────────────────╮\n'
printf '│  Commit blocked — %d file(s) over %s tokens (tokens = bytes/4)\n' "$COUNT" "$MAX_TOKENS"
printf '╰─────────────────────────────────────────────────────────────────╯\n\n'
printf '%b\n' "$OFFENDERS"
cat <<MSG
  Your changes are still staged. Split each file above into smaller
  files of under ${MAX_TOKENS} tokens (~${MAX_BYTES} bytes) each, then commit again.

  How to split:
    1. Find the seams: group the code by responsibility (one component,
       class, route group, service, or feature per file). Don't cut at an
       arbitrary line count.
    2. Move each group into its own file next to the original, named for
       what it does (e.g. user-service.ts -> user-service/{queries,mutations,
       validation}.ts, or OrderController.php -> OrderController + Actions/*).
    3. Keep the original path as a thin entry point that imports and
       re-exports the pieces, so existing imports keep working.
    4. Move shared types, constants and helpers into their own module
       instead of duplicating them.
    5. Tests: split the matching test file the same way, one test file per
       new module.
    6. Run the type-checker / linter / tests, then stage the new files
       (git add) and commit.

  Not agent-authored (generated, vendored, data, lockfile)? Then skip it:
    - mark it in .gitattributes:   path/to/file linguist-generated=true
    - or add a glob to .tokenignore in the repo root

  Other options:
    git config hooks.maxFileTokens 8000      change the limit for this repo
    SKIP_TOKEN_CHECK=1 git commit ...        bypass once

MSG
} >&2
exit 1
