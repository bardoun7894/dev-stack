#!/usr/bin/env python3
"""track — Mac CLI for one-shot world events.

Subcommands:
  add   — build a contract event, POST it; on failure stash to outbox.
  flush — retry the outbox, truncate only what the server accepted.
  --dry-run — print the event instead of posting (works on `add`).
"""
from __future__ import annotations

import argparse
import hashlib
import os
import re
import sys
import time
from datetime import datetime, timezone

# Allow running both as `scripts/world/track` and `python -m world.track`.
sys.path.insert(0, str(__import__("os").path.dirname(__import__("os").path.realpath(__file__))))
from lib_world import (
    SRC_TRACK, event, json_dumps, make_id, normalise_event_lengths,
    outbox_append, outbox_load, outbox_rewrite, post_events,
    rejected_append, slug,
)

# Per-flush cap on server rejections (one bad event per rejection, so the
# rest of the batch can still be retried).
REJECT_LIMIT_PER_FLUSH = 50

# Matches the server's "event N: <reason>" error body (e.g. on title length).
_REJECTED_BODY_RE = re.compile(r"event (\d+):")


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="track", add_help=True)
    p.add_argument("--dry-run", action="store_true", help="print the event instead of POSTing")
    sub = p.add_subparsers(dest="cmd", required=True)

    add_p = sub.add_parser("add", help="emit one event")
    add_p.add_argument("--kind", required=True)
    add_p.add_argument("--project", required=True)
    add_p.add_argument("--status", required=True)
    add_p.add_argument("--title", required=True)
    add_p.add_argument("--ref", default="")
    add_p.add_argument("--url", default="")
    add_p.add_argument("--actor", default="owner")
    add_p.add_argument("--model", default="")
    add_p.add_argument("--cost", type=float, default=None)
    add_p.add_argument("--dur", type=float, default=None)
    add_p.add_argument("--source", default=SRC_TRACK, help="event source (default: track)")
    add_p.add_argument("--key", default=None, help="stable key; id = sha1('<source>:<key>')")
    sub.add_parser("flush", help="re-send the outbox")

    return p.parse_args(argv)

def cmd_add(args: argparse.Namespace, dry_run: bool) -> int:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    if args.key:
        id_ = make_id(args.source, args.key)
    else:
        id_ = hashlib.sha1(f"track:{ts}{args.kind}{args.project}{args.title}".encode("utf-8")).hexdigest()
    ev = event(
        id=id_, ts=ts, project=args.project, kind=args.kind, status=args.status,
        title=args.title, ref=args.ref, url=args.url, actor=args.actor,
        model=args.model, cost=args.cost, dur_s=args.dur, source=args.source,
    )
    if dry_run:
        print(json_dumps(ev))
        return 0
    try:
        rep = post_events([ev])
        print(json_dumps(rep))
        return 0
    except Exception as e:
        outbox_append([ev])
        print(f"queued to outbox: {e}", file=sys.stderr)
        return 2  # non-zero so callers can re-run `track flush`

def cmd_flush(dry_run: bool) -> int:
    pending = outbox_load()
    if not pending:
        print("outbox empty")
        return 0
    # Scrub + cap every length-limited field by UTF-16 code units, so the
    # server (which measures with JS .length) never sees a 141-codepoint title
    # it would reject with a 400 for the whole batch.
    for ev in pending:
        normalise_event_lengths(ev)
    if dry_run:
        print(f"would flush {len(pending)} events")
        return 0
    import lib_world
    url = os.environ.get("WORLD_URL", lib_world.DEFAULT_URL)
    token = os.environ.get("WORLD_TOKEN", "")
    timeout = float(os.environ.get("WORLD_TIMEOUT", "5"))
    chunk = 500
    accepted = 0
    duplicate = 0
    rejected_count = 0
    remaining = list(pending)
    while remaining:
        batch = remaining[:chunk]
        try:
            rep = post_events(batch, url=url, timeout=timeout, token=token)
            accepted += int(rep.get("accepted", 0) or 0)
            duplicate += int(rep.get("duplicate", 0) or 0)
            remaining = remaining[len(batch):]
            continue
        except RuntimeError as e:
            # 4xx → try to identify the bad event by index, move it to
            # rejected.jsonl, and retry the rest of the batch.
            msg = str(e)
            m = _REJECTED_BODY_RE.search(msg)
            if not m or rejected_count >= REJECT_LIMIT_PER_FLUSH:
                outbox_rewrite(remaining)
                print(f"flush failed, kept {len(remaining)}: {msg}", file=sys.stderr)
                return 2
            idx = int(m.group(1))
            if not (0 <= idx < len(batch)):
                outbox_rewrite(remaining)
                print(f"flush failed, bad index in error: {msg}", file=sys.stderr)
                return 2
            bad = batch[idx]
            rejected_append(bad, msg)
            rejected_count += 1
            # Retry the rest of THIS batch (drop the bad event).
            rest = batch[:idx] + batch[idx + 1:]
            remaining = rest + remaining[len(batch):]
            continue
        except Exception as e:
            outbox_rewrite(remaining)
            print(f"flush failed, kept {len(remaining)}: {e}", file=sys.stderr)
            return 2
    outbox_rewrite(remaining)  # empty list clears the outbox
    print(json_dumps({"accepted": accepted, "duplicate": duplicate,
                      "rejected": rejected_count, "remaining": len(remaining)}))
    return 0

def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.cmd == "add":
        return cmd_add(args, args.dry_run or ("--dry-run" in argv))
    if args.cmd == "flush":
        return cmd_flush(args.dry_run or ("--dry-run" in argv))
    return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
