#!/usr/bin/env python3
"""track — Mac CLI for one-shot world events.

Subcommands:
  add   — build a contract event, POST it; on failure stash to outbox.
  flush — retry the outbox, truncate only what the server accepted.
  --dry-run — print the event instead of posting (works on `add`).
"""
from __future__ import annotations

import argparse
import hashlib
import sys
import time
from datetime import datetime, timezone

# Allow running both as `scripts/world/track` and `python -m world.track`.
sys.path.insert(0, str(__import__("os").path.dirname(__import__("os").path.realpath(__file__))))
from lib_world import (
    SRC_TRACK, event, json_dumps, outbox_append, outbox_load, outbox_rewrite,
    post_events, scrub_title, slug,
)

def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="track", add_help=True)
    p.add_argument("--dry-run", action="store_true", help="print the event instead of POSTing")
    sub = p.add_subparsers(dest="cmd", required=True)

    add_p = sub.add_parser("add", help="emit one event")
    add_p.add_argument("--kind", required=True)
    add_p.add_argument("--project", required=True)
    add_p.add_argument("--status", required=True)
    add_p.add_argument("--title", required=True)
    add_p.add_argument("--ref", default="")
    add_p.add_argument("--url", default="")
    add_p.add_argument("--actor", default="owner")
    add_p.add_argument("--model", default="")
    add_p.add_argument("--cost", type=float, default=None)
    add_p.add_argument("--dur", type=float, default=None)
    sub.add_parser("flush", help="re-send the outbox")

    return p.parse_args(argv)

def cmd_add(args: argparse.Namespace, dry_run: bool) -> int:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    id_ = hashlib.sha1(f"track:{ts}{args.kind}{args.project}{args.title}".encode("utf-8")).hexdigest()
    ev = event(
        id=id_, ts=ts, project=args.project, kind=args.kind, status=args.status,
        title=args.title, ref=args.ref, url=args.url, actor=args.actor,
        model=args.model, cost=args.cost, dur_s=args.dur, source=SRC_TRACK,
    )
    if dry_run:
        print(json_dumps(ev))
        return 0
    try:
        rep = post_events([ev])
        print(json_dumps(rep))
        return 0
    except Exception as e:
        outbox_append([ev])
        print(f"queued to outbox: {e}", file=sys.stderr)
        return 2  # non-zero so callers can re-run `track flush`

def cmd_flush(dry_run: bool) -> int:
    pending = outbox_load()
    if not pending:
        print("outbox empty")
        return 0
    # Neutralise server-secret-like patterns in titles before send, so
    # already-queued events (which pre-date scrub_title on the producer
    # path) don't 400 a whole batch.
    for ev in pending:
        if isinstance(ev.get("title"), str):
            ev["title"] = scrub_title(ev["title"])
    if dry_run:
        print(f"would flush {len(pending)} events")
        return 0
    from lib_world import send
    try:
        rep = send(pending)
    except Exception as e:
        outbox_rewrite(pending)
        print(f"flush failed, kept {len(pending)}: {e}", file=sys.stderr)
        return 2
    accepted = int(rep.get("accepted", 0)) + int(rep.get("duplicate", 0))
    remaining = pending[accepted:] if accepted > 0 else []
    outbox_rewrite(remaining)
    print(json_dumps({**rep, "remaining": len(remaining)}))
    return 0 if not remaining else 1

def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.cmd == "add":
        return cmd_add(args, args.dry_run or ("--dry-run" in argv))
    if args.cmd == "flush":
        return cmd_flush(args.dry_run or ("--dry-run" in argv))
    return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
