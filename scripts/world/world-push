#!/usr/bin/env python3
"""world-push — collector run by launchd every 5 minutes.

Reads each source family, emits contract events, deduplicates by id against the
local sent-id cache, and POSTs batches (<=500) to the godhome ingest endpoint.

Idempotent re-runs are safe — server dedupes by id.

Flags:
  WORLD_DRY_RUN=1          print counts per source/kind, do not POST or write cache
  WORLD_BACKFILL_DAYS=90   (advanced) change the time horizon for git/tasks/etc.
"""
from __future__ import annotations

import fcntl
import os
import re
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import lib_world
import world_push_sources as wps


def bucket(events, sources=wps.SOURCES):
    by_source: dict[str, list[dict]] = {s: [] for s in sources}
    by_source.setdefault("track", [])
    for ev in events:
        by_source.setdefault(ev.get("source", "track"), []).append(ev)
    return by_source


def send_dropping_rejects(events, url, timeout, token, chunk=500) -> dict:
    """POST in chunks. When the server refuses the events themselves (lib_world.payload_rejection):
    if it names one event (`event N:`), that event moves to rejected.jsonl and the rest is retried;
    if it names none, the batch is split in half until the bad event is alone, and then that one is
    rejected. So one unidentifiable bad event can no longer stall the whole backlog run after run.
    5xx, transport and auth/URL/rate-limit errors raise (nothing is rejected; the next run retries).
    Rejected events are counted in the result and their ids are still saved as sent by the caller,
    so they are not re-collected and rejected again.
    """
    queue = [list(events[i:i + chunk]) for i in range(0, len(events), chunk)]
    total = {"accepted": 0, "duplicate": 0, "rejected": 0}
    while queue:
        batch = queue.pop(0)
        if not batch:
            continue
        try:
            rep = lib_world.post_events(batch, url=url, timeout=timeout, token=token)
        except RuntimeError as e:
            msg = str(e)
            if not lib_world.payload_rejection(msg):
                raise
            m = re.search(r"event (\d+):", msg)
            if m and int(m.group(1)) < len(batch):
                i = int(m.group(1))
                lib_world.rejected_append(batch[i], msg)
                total["rejected"] += 1
                queue.insert(0, batch[:i] + batch[i + 1:])
            elif len(batch) == 1:
                lib_world.rejected_append(batch[0], msg)
                total["rejected"] += 1
            else:
                mid = len(batch) // 2
                queue[0:0] = [batch[:mid], batch[mid:]]
            continue
        total["accepted"] += int(rep.get("accepted", 0) or 0)
        total["duplicate"] += int(rep.get("duplicate", 0) or 0)
    return total


def main(argv: list[str]) -> int:
    dry_run = bool(int(os.environ.get("WORLD_DRY_RUN", "0")))
    url = os.environ.get("WORLD_URL", lib_world.DEFAULT_URL)
    token = lib_world.env_token()
    timeout = float(os.environ.get("WORLD_TIMEOUT", "5"))
    state_dir = Path(os.environ.get("WORLD_STATE_DIR", str(Path.home() / ".local/state/world")))

    if not dry_run:
        state_dir.mkdir(parents=True, exist_ok=True)
        lock_fh = open(state_dir / "world-push.lock", "w")
        try:
            fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("another world-push run holds the lock; exiting", file=sys.stderr)
            return 0

    collectors = [
        ("session-tasks", wps.collect_session_tasks),
        ("spec-kit",      wps.collect_specs),
        ("jdelegate",     wps.collect_jdelegate),
        ("git",           wps.collect_git),
        ("gh-prs",        wps.collect_prs),
        ("skills",        wps.collect_skills),
        ("skill-use",     wps.collect_skill_use),
        ("market-swot",   wps.collect_swot),
        ("kb",            wps.collect_kb),
        ("herdr",         wps.collect_herdr),
        ("claude-sessions", wps.collect_transcripts),
    ]

    collector_failed = False
    all_events: list[dict] = []
    by_source_counts: dict[str, int] = {}
    by_kind_counts: dict[str, int] = {}

    for src_name, fn in collectors:
        t0 = time.time()
        try:
            events = list(fn())
        except Exception as e:
            print(f"[{src_name}] ERROR: {e}", file=sys.stderr)
            events = []
            collector_failed = True
        if dry_run:
            print(f"[timing] {src_name}: {time.time()-t0:.1f}s n={len(events)}", file=sys.stderr)
        by_source_counts[src_name] = len(events)
        for ev in events:
            by_kind_counts[ev["kind"]] = by_kind_counts.get(ev["kind"], 0) + 1
        all_events.extend(events)

    # Heartbeats per source.
    hb = wps.heartbeat_counts(bucket(all_events))
    all_events.extend(hb)
    for ev in hb:
        by_kind_counts["source"] = by_kind_counts.get("source", 0) + 1

    # Dedupe vs local sent cache.
    sent = lib_world.sent_ids_load() if not dry_run else set()
    new_events = [ev for ev in all_events if ev["id"] not in sent]
    skipped = len(all_events) - len(new_events)

    if dry_run:
        print("# world-push DRY RUN")
        print(f"events total: {len(all_events)} (new after dedupe: {len(new_events)}, cached: {skipped})")
        print("# by source:")
        for k, v in sorted(by_source_counts.items()):
            print(f"  {k}: {v}")
        print("# by kind:")
        for k, v in sorted(by_kind_counts.items()):
            print(f"  {k}: {v}")
        return 0

    try:
        rep = send_dropping_rejects(new_events, url=url, timeout=timeout, token=token)
        print(f"sent={rep.get('accepted',0)} dup={rep.get('duplicate',0)} rejected={rep.get('rejected',0)} new={len(new_events)} skipped={skipped}")
    except Exception as e:
        # Network/server failure: nothing is marked sent, so the next run
        # re-collects these events (collector cursors are not committed either).
        print(f"send failed, will retry next run: {e}", file=sys.stderr)
        return 2

    # A failed collector may have advanced a cursor without emitting its events;
    # leave cursors uncommitted so the next run re-collects them.
    if not collector_failed:
        wps.commit_state()
    # Persist full id set (existing + new).
    lib_world.sent_ids_save(list(sent | {ev["id"] for ev in all_events if ev["id"] not in sent}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
