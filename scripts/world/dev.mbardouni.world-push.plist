<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.mbardouni.world-push</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.local/bin/world-push</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/mohamedbardouni/Library/Logs/world-push.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mohamedbardouni/Library/Logs/world-push.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/mohamedbardouni/.local/bin</string>
    <key>HOME</key>
    <string>/Users/mohamedbardouni</string>
    <key>WORLD_STATE_DIR</key>
    <string>/Users/mohamedbardouni/.local/state/world</string>
  </dict>
</dict>
</plist>
